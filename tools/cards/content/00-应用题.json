{
  "module_dir": "12-奥数-应用题",
  "items": [
    {
      "id": "wp-unit-rate",
      "title": "归一与归总",
      "span": 1,
      "pair_with": "wp-average",
      "blocks": [
        {
          "t": "sec",
          "v": "基本关系"
        },
        {
          "t": "fx",
          "v": "\\text{每份量}=\\text{总量}\\div\\text{份数}"
        },
        {
          "t": "fx",
          "v": "\\text{总量}=\\text{每份量}\\times\\text{份数}"
        },
        {
          "t": "li",
          "v": "份数 $=$ 总量 $\\div$ 每份量；三式互为逆运算，知二求一"
        },
        {
          "t": "sec",
          "v": "正归一反归一"
        },
        {
          "t": "li",
          "v": "正归一：先除求单一量，再乘求几个这样的量"
        },
        {
          "t": "li",
          "v": "反归一：先除求单一量，再除求总量里有几份"
        },
        {
          "t": "li",
          "v": "若题目未直接给出单一量，先除求单一量；若已给出则直接计算"
        },
        {
          "t": "sec",
          "v": "归总对比"
        },
        {
          "t": "li",
          "v": "归总：总量不变，先乘出总量，再按新分法重分"
        },
        {
          "t": "li",
          "v": "两次归一连除到底：$960\\div3\\div4$ 得 1 台 1 小时的量"
        },
        {
          "t": "li",
          "v": "验算：把结果乘回份数，看能否还原成原总量"
        },
        {
          "t": "tip",
          "v": "识别信号：照这样计算、同样的速度、换人数换份数后的新总量"
        },
        {
          "t": "warn",
          "v": "易错：单一量必须先求再乘；总量变了还用原来的份数"
        }
      ]
    },
    {
      "id": "wp-sum-difference",
      "title": "和差问题",
      "span": 1,
      "pair_with": "wp-sum-multiple",
      "blocks": [
        {
          "t": "sec",
          "v": "基本公式"
        },
        {
          "t": "fx",
          "v": "\\text{大}=\\frac{\\text{和}+\\text{差}}{2},\\quad \\text{小}=\\frac{\\text{和}-\\text{差}}{2}"
        },
        {
          "t": "li",
          "v": "也写成 $\\text{大}=\\frac{\\text{和}}{2}+\\frac{\\text{差}}{2}$，小即为中间数减一半差"
        },
        {
          "t": "li",
          "v": "差的一半，正是移多补少要搬动的数量"
        },
        {
          "t": "sec",
          "v": "隐藏条件"
        },
        {
          "t": "li",
          "v": "周长要先折半才是长宽之和；平均数乘个数才是总和"
        },
        {
          "t": "li",
          "v": "甲给乙 $a$ 个后相等，原差 $=2a$；给完还多 $b$，差 $=2a+b$"
        },
        {
          "t": "li",
          "v": "两两之和型：三和相加每量各算两次，总和 $=$ 三和之和 $\\div2$"
        },
        {
          "t": "li",
          "v": "三个量以上：取最小量为基准，其余写成基准加差再求和"
        },
        {
          "t": "li",
          "v": "和一定时两数越接近乘积越大，可用来判极值问法"
        },
        {
          "t": "tip",
          "v": "识别信号：共、合计配上多、少、相差、给、搬；两条件两未知量"
        },
        {
          "t": "warn",
          "v": "易错：忘除以 $2$；甲给乙 $5$ 个后相等，差是 $10$ 不是 $5$"
        }
      ]
    },
    {
      "id": "wp-sum-multiple",
      "title": "和倍与差倍",
      "span": 1,
      "pair_with": "wp-sum-difference",
      "blocks": [
        {
          "t": "sec",
          "v": "和倍"
        },
        {
          "t": "fx",
          "v": "\\text{小}=\\text{和}\\div(\\text{倍数}+1),\\quad \\text{大}=\\text{小}\\times\\text{倍数}"
        },
        {
          "t": "li",
          "v": "把最小量当 $1$ 份，总份数 $=$ 倍数 $+1$，和 $\\div$ 总份数即 1 份"
        },
        {
          "t": "li",
          "v": "多 $m$ 先从和里减 $m$，少 $m$ 先给和补 $m$，凑整的是和不是倍数"
        },
        {
          "t": "li",
          "v": "隐藏的和：周长先折半，平均数先乘个数，倒出放入后先算新和"
        },
        {
          "t": "sec",
          "v": "差倍"
        },
        {
          "t": "fx",
          "v": "\\text{小}=\\text{差}\\div(\\text{倍数}-1),\\quad \\text{大}=\\text{小}\\times\\text{倍数}"
        },
        {
          "t": "li",
          "v": "差对应的是 $n-1$ 份，不是 $n$ 份，这一步最常写错"
        },
        {
          "t": "li",
          "v": "隐藏倍数：多 $3$ 倍即 $4$ 倍；商 $7$ 余 $8$ 即甲 $=7$ 乙 $+8$"
        },
        {
          "t": "li",
          "v": "倍数变了要先统一份数，拿不变量对应的份数通分"
        },
        {
          "t": "tip",
          "v": "识别信号：一共配上「是几倍、多几倍、商几余几」；给和用和倍、给差用差倍"
        },
        {
          "t": "warn",
          "v": "易错：漏加 $1$、忘减 $1$；零头方向反了——多几要减、少几要加"
        }
      ]
    },
    {
      "id": "wp-profit-loss",
      "title": "盈亏问题",
      "span": 1,
      "pair_with": "wp-chicken-rabbit",
      "blocks": [
        {
          "t": "sec",
          "v": "人数公式"
        },
        {
          "t": "fx",
          "v": "(\\text{盈}+\\text{亏})\\div\\text{两次每人差}=\\text{人数}"
        },
        {
          "t": "li",
          "v": "盈亏型：$($盈 $+$ 亏$)\\div$ 两次分得之差 $=$ 人数"
        },
        {
          "t": "li",
          "v": "盈盈型：$($大盈 $-$ 小盈$)\\div$ 两次分得之差 $=$ 人数"
        },
        {
          "t": "li",
          "v": "亏亏型：$($大亏 $-$ 小亏$)\\div$ 两次分得之差 $=$ 人数"
        },
        {
          "t": "li",
          "v": "一盈一正好：人数 $=$ 盈 $($或亏$)\\div$ 两次分得之差"
        },
        {
          "t": "sec",
          "v": "物品总数"
        },
        {
          "t": "li",
          "v": "盈、亏的单位先对齐：同是几个人或同是几间宿舍"
        },
        {
          "t": "li",
          "v": "回代：物品数 $=$ 每人份 $\\times$ 人数，盈则加、亏则减"
        },
        {
          "t": "li",
          "v": "必须用另一种分法检验，两种都对才算过关"
        },
        {
          "t": "tip",
          "v": "识别信号：两种分法、多了几少了几个、住不下、剩下几张"
        },
        {
          "t": "warn",
          "v": "易错：除数是两次「每人分得之差」，不是两次盈数之差"
        }
      ]
    },
    {
      "id": "wp-chicken-rabbit",
      "title": "鸡兔同笼",
      "span": 1,
      "pair_with": "wp-profit-loss",
      "blocks": [
        {
          "t": "sec",
          "v": "核心公式"
        },
        {
          "t": "fx",
          "v": "\\text{单位数}=\\text{总差}\\div\\text{单位差}"
        },
        {
          "t": "li",
          "v": "假设全是鸡：$\\text{兔}=(\\text{总脚}-2\\times\\text{总头})\\div(4-2)$"
        },
        {
          "t": "li",
          "v": "假设全是兔同理：多出的脚数 $\\div2$ 就是鸡的只数"
        },
        {
          "t": "li",
          "v": "总差要同类相比：脚比脚、分比分，不能拿脚减头"
        },
        {
          "t": "sec",
          "v": "单位差怎么定"
        },
        {
          "t": "li",
          "v": "同向都用得到取减：$|4-2|=2$"
        },
        {
          "t": "li",
          "v": "一得一失取加：答对 $+10$、答错 $-2$，单位差是 $12$"
        },
        {
          "t": "li",
          "v": "抬脚法：脚数减半，兔数 $=$ 半脚数 $-$ 头数"
        },
        {
          "t": "li",
          "v": "三类对象先按配比打包成两类，再一次假设"
        },
        {
          "t": "tip",
          "v": "识别信号：两个总量、两类对象——头数脚数、题数得分、运费赔偿"
        },
        {
          "t": "warn",
          "v": "易错：单位差加减不分；答错倒扣时是 $10+2=12$ 不是 $8$"
        }
      ]
    },
    {
      "id": "wp-average",
      "title": "平均数应用题",
      "span": 1,
      "pair_with": "wp-unit-rate",
      "blocks": [
        {
          "t": "sec",
          "v": "基本关系"
        },
        {
          "t": "fx",
          "v": "\\text{平均数}=\\text{总数量}\\div\\text{总份数}"
        },
        {
          "t": "li",
          "v": "记总量 $T$、平均数 $a$、份数 $n$：$T=an$，$a=T\\div n$，$n=T\\div a$"
        },
        {
          "t": "sec",
          "v": "移多补少"
        },
        {
          "t": "li",
          "v": "总量的变化量 $\\div$ 份数 $=$ 平均数的变化量"
        },
        {
          "t": "li",
          "v": "份数也变：先算新的总数量与新的总份数，再相除"
        },
        {
          "t": "li",
          "v": "加权平均：分组平均数按各组份数加权，不能取算术平均"
        },
        {
          "t": "sec",
          "v": "平均速度"
        },
        {
          "t": "fx",
          "v": "\\text{等路程往返平均速度}=\\frac{2v_1v_2}{v_1+v_2}"
        },
        {
          "t": "li",
          "v": "仅在去程、返程路程相等时使用；路程不等须回到总路程 ÷ 总时间"
        },
        {
          "t": "li",
          "v": "总路程 $\\div$ 总时间，不是两段速度的平均数"
        },
        {
          "t": "tip",
          "v": "识别信号：平均分、平均速度、去掉或加入一个数后平均数变化"
        },
        {
          "t": "warn",
          "v": "易错：两个平均数取算术平均，只在两份数相同时才成立"
        }
      ]
    },
    {
      "id": "app-page-number",
      "title": "页码问题",
      "span": 1,
      "pair_with": null,
      "blocks": [
        {
          "t": "sec",
          "v": "数码分段"
        },
        {
          "t": "fx",
          "v": "D_k=9\\times10^{k-1}\\times k"
        },
        {
          "t": "li",
          "v": "$k$ 为正整数；$k$ 位页码从 $10^{k-1}$ 到 $10^k-1$，共 $9\\times10^{k-1}$ 页，每页写 $k$ 个数码"
        },
        {
          "t": "sec",
          "v": "反求页码"
        },
        {
          "t": "li",
          "v": "先减去完整数位段；进入 $k$ 位段后，令剩余数码数 $r=kq+s$，其中 $0\\le s<k$"
        },
        {
          "t": "li",
          "v": "$s=0$：末页 $=10^{k-1}+q-1$；$s>0$：第 $r$ 个数码落在页码 $10^{k-1}+q$ 的第 $s$ 位；整本书末页必须 $s=0$"
        },
        {
          "t": "sec",
          "v": "统计某个数码"
        },
        {
          "t": "li",
          "v": "按个位、十位、百位分别统计；统计数字 $0$ 时，不计页码中不存在的前导零"
        },
        {
          "t": "tip",
          "v": "识别信号：编书要用多少个数码、某数字出现几次、给出数码总数反求页数"
        },
        {
          "t": "warn",
          "v": "易错：页数不等于数码数；默认页码从 1 连续编号，若题目有跳号或不编号的页须先调整"
        }
      ]
    },
    {
      "id": "wp-tree-planting",
      "title": "植树问题",
      "span": 1,
      "pair_with": "wp-square-formation",
      "blocks": [
        {
          "t": "sec",
          "v": "基本关系"
        },
        {
          "t": "fx",
          "v": "\\text{全长}=\\text{株距}\\times\\text{段数}"
        },
        {
          "t": "li",
          "v": "段数 $=$ 全长 $\\div$ 株距；株距 $=$ 全长 $\\div$ 段数"
        },
        {
          "t": "sec",
          "v": "三种情形"
        },
        {
          "t": "li",
          "v": "两端都植：段数 $=$ 棵数 $-1$"
        },
        {
          "t": "li",
          "v": "只植一端：段数 $=$ 棵数"
        },
        {
          "t": "li",
          "v": "两端都不植：段数 $=$ 棵数 $+1$"
        },
        {
          "t": "li",
          "v": "拿不准就画一条短线段数一遍，比背口诀稳"
        },
        {
          "t": "sec",
          "v": "封闭路线"
        },
        {
          "t": "fx",
          "v": "\\text{棵数}=\\text{段数}=\\text{周长}\\div\\text{株距}"
        },
        {
          "t": "li",
          "v": "首尾同点不多不少；环形花坛、池塘四周都用它"
        },
        {
          "t": "li",
          "v": "变式同构：锯成 $n$ 段锯 $n-1$ 次，上 $n$ 楼爬 $n-1$ 层"
        },
        {
          "t": "tip",
          "v": "识别信号：每隔几米栽一棵、锯木头、爬楼梯、敲钟、池塘四周"
        },
        {
          "t": "warn",
          "v": "易错：环形与直线混用；两端都不栽棵数比段数少 $1$"
        }
      ]
    },
    {
      "id": "wp-square-formation",
      "title": "方阵问题",
      "span": 1,
      "pair_with": "wp-tree-planting",
      "blocks": [
        {
          "t": "sec",
          "v": "每层人数"
        },
        {
          "t": "fx",
          "v": "\\text{每层总数}=(\\text{每边数}-1)\\times4"
        },
        {
          "t": "li",
          "v": "反推：每边数 $=$ 每层总数 $\\div4+1$"
        },
        {
          "t": "li",
          "v": "相邻两层相差 $8$；跨一层每边人数少 $2$"
        },
        {
          "t": "sec",
          "v": "实心与空心"
        },
        {
          "t": "fx",
          "v": "\\text{实心总数}=\\text{最外层每边数}^2"
        },
        {
          "t": "fx",
          "v": "\\text{空心总数}=4m(n-m)"
        },
        {
          "t": "li",
          "v": "记每边 $n$、层数 $m$，且 $n>2m$（中心仍有空位）：也写成 $($最外层每边数 $-$ 层数$)\\times$ 层数 $\\times4$"
        },
        {
          "t": "li",
          "v": "也等于 $($最外层人数 $+$ 最内层人数$)\\times$ 层数 $\\div2$"
        },
        {
          "t": "li",
          "v": "外添一整层：$n\\to n+2$，增加 $4n+4$ 人"
        },
        {
          "t": "tip",
          "v": "识别信号：正方形队伍、最外层多少人、中空几层、添一层要几人"
        },
        {
          "t": "warn",
          "v": "易错：最外层算成 $4n$（四角重复）；反推忘加 $1$；层差是 $8$ 不是 $4$"
        }
      ]
    },
    {
      "id": "owp-grazing",
      "title": "牛吃草",
      "span": 1,
      "pair_with": "wp-work",
      "blocks": [
        {
          "t": "sec",
          "v": "草在长"
        },
        {
          "t": "fx",
          "v": "g=\\frac{n_1t_1-n_2t_2}{t_1-t_2},\\quad G=(n_1-g)t_1"
        },
        {
          "t": "li",
          "v": "约定：$n_1$ 为少牛多天、$n_2$ 为多牛少天，且 $t_1>t_2$；两组天数不能相同"
        },
        {
          "t": "li",
          "v": "① $g$：少牛 $\\times$ 多天减多牛 $\\times$ 少天，再除以天数差"
        },
        {
          "t": "li",
          "v": "③ 天数 $=G\\div($牛数 $-g)$；牛数 $=G\\div$ 天数 $+g$"
        },
        {
          "t": "sec",
          "v": "草在减"
        },
        {
          "t": "fx",
          "v": "d=\\frac{n_2t_2-n_1t_1}{t_1-t_2},\\quad G=(n_1+d)t_1"
        },
        {
          "t": "li",
          "v": "① $d$：多牛 $\\times$ 少天减少牛 $\\times$ 多天，再除以天数差"
        },
        {
          "t": "li",
          "v": "② $G=($牛数 $+d)\\times$ 天数；③ 天数 $=G\\div($牛数 $+d)$，牛数 $=G\\div t-d$"
        },
        {
          "t": "sec",
          "v": "临界与变形"
        },
        {
          "t": "li",
          "v": "牛数 $\\le g$ 永远吃不完，无限期吃最多放 $g$ 头"
        },
        {
          "t": "tip",
          "v": "识别信号：草每天匀速生长、检票口同时来人、水池进水又放水"
        },
        {
          "t": "warn",
          "v": "易错：把牛吃总量当原有草量；草在减时改写 $+d$"
        }
      ]
    },
    {
      "id": "wp-work",
      "title": "工程问题",
      "span": 1,
      "pair_with": "owp-grazing",
      "blocks": [
        {
          "t": "sec",
          "v": "基本关系"
        },
        {
          "t": "fx",
          "v": "\\text{总量}=\\text{工效}\\times\\text{时间}"
        },
        {
          "t": "li",
          "v": "工效 $=$ 总量 $\\div$ 时间；时间 $=$ 总量 $\\div$ 工效"
        },
        {
          "t": "li",
          "v": "总量抽象成 $1$：$12$ 天完成，工效就是 $\\frac1{12}$"
        },
        {
          "t": "sec",
          "v": "两条主线"
        },
        {
          "t": "li",
          "v": "同时做：工效相加，合作工效 $=$ 各队工效之和"
        },
        {
          "t": "li",
          "v": "先后做：工作量相加，各段工作量 $=$ 工效 $\\times$ 该段天数"
        },
        {
          "t": "li",
          "v": "合作 $T$ 天、甲单独 $t$ 天：乙工效 $=\\frac1T-\\frac1t$"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "负工效：净工效 $=$ 进 $-$ 出，$\\le0$ 时永远注不满"
        },
        {
          "t": "tip",
          "v": "识别信号：单独做要几天、合作、中途离开、轮流、进出水管"
        },
        {
          "t": "warn",
          "v": "易错：合作不是把天数相加，而是 $1\\div(\\frac1{12}+\\frac1{18})$"
        }
      ]
    },
    {
      "id": "owp-economics",
      "title": "经济问题",
      "span": 1,
      "pair_with": "wp-concentration",
      "blocks": [
        {
          "t": "sec",
          "v": "四量三率"
        },
        {
          "t": "fx",
          "v": "\\text{售价}=\\text{成本}+\\text{利润}"
        },
        {
          "t": "li",
          "v": "利润率 $=$ 利润 $\\div$ 成本 $\\times100\\%$，分母永远是成本"
        },
        {
          "t": "fx",
          "v": "\\text{售价}=\\text{成本}\\times(1+r),\\quad \\text{成本}=\\frac{\\text{售价}}{1+r}"
        },
        {
          "t": "li",
          "v": "$r$ 用小数表示利润率，例如 $25\\%=0.25$"
        },
        {
          "t": "sec",
          "v": "折扣与利息"
        },
        {
          "t": "li",
          "v": "售价 $=$ 定价 $\\times$ 折数 $\\div10$；折扣的基准是定价不是成本"
        },
        {
          "t": "fx",
          "v": "\\text{利息}=\\text{本金}\\times\\text{利率}\\times\\text{期数}"
        },
        {
          "t": "sec",
          "v": "易混结论"
        },
        {
          "t": "li",
          "v": "整体利润率按成本加权：$\\overline r=$ 总利润 $\\div$ 总成本"
        },
        {
          "t": "li",
          "v": "售价相同、一盈一亏同率，合计必亏，亏损率是 $r^2$"
        },
        {
          "t": "li",
          "v": "先涨 $25\\%$ 再打八折：$1.25\\times0.8=1$，恰好回到原价"
        },
        {
          "t": "tip",
          "v": "识别信号：进价利润率、打几折、赚了百分之几、本金利率"
        },
        {
          "t": "warn",
          "v": "易错：利润率除以售价、折扣打在成本上，先涨后折不能相加减"
        }
      ]
    },
    {
      "id": "wp-concentration",
      "title": "浓度问题",
      "span": 1,
      "pair_with": "owp-economics",
      "blocks": [
        {
          "t": "sec",
          "v": "基本关系"
        },
        {
          "t": "fx",
          "v": "\\text{溶液}=\\text{溶质}+\\text{溶剂}"
        },
        {
          "t": "li",
          "v": "浓度 $=$ 溶质 $\\div$ 溶液 $\\times100\\%$；溶质 $=$ 溶液 $\\times$ 浓度"
        },
        {
          "t": "sec",
          "v": "溶质账本"
        },
        {
          "t": "fx",
          "v": "M_1p_1+M_2p_2=(M_1+M_2)p"
        },
        {
          "t": "sec",
          "v": "十字交叉"
        },
        {
          "t": "fx",
          "v": "\\frac{M_1}{M_2}=\\frac{p-p_2}{p_1-p}"
        },
        {
          "t": "li",
          "v": "上差 $(p-p_2)$ 对 $p_1$，下差 $(p_1-p)$ 对 $p_2$，交叉相配"
        },
        {
          "t": "li",
          "v": "只适两种原料，目标浓度须夹在两者之间；加水按 $0\\%$ 算"
        },
        {
          "t": "li",
          "v": "倒出加满：每次搅匀后倒出 $x$ 克，再补纯水至原总量 $M$；重复 $n$ 次才用 $p_n=p_0(1-\\frac{x}{M})^n$"
        },
        {
          "t": "tip",
          "v": "识别信号：加水蒸发加盐、两溶液混合、倒出加满、交换等量"
        },
        {
          "t": "warn",
          "v": "易错：浓度是溶质÷溶液不是÷水；两次稀释不能相减"
        }
      ]
    }
  ]
}
