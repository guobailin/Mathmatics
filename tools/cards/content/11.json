{
  "module_dir": "11-奥数-组合",
  "items": [
    {
      "id": "ocb-magic-square",
      "title": "幻方",
      "span": 1,
      "pair_with": "ocb-number-array",
      "blocks": [
        {
          "t": "sec",
          "v": "幻和与重数"
        },
        {
          "t": "fx",
          "v": "S=\\frac{n(n^2+1)}{2}"
        },
        {
          "t": "li",
          "v": "$n$ 行把 $n^2$ 个数各数一遍，故 $nS=T$，任何幻方题先算 $S$"
        },
        {
          "t": "li",
          "v": "三阶过中心四线给 $4S=T+3c$，故 $S=3c$，中心即九数平均数"
        },
        {
          "t": "li",
          "v": "三阶中心 $c=S\\div3$；更高奇数阶中心不能只由幻和反推"
        },
        {
          "t": "li",
          "v": "重数法：数清每格被算几次，多算 $r-1$ 次；对称两格和 $2c$"
        },
        {
          "t": "sec",
          "v": "结构与构造"
        },
        {
          "t": "li",
          "v": "角格等于与它不同行列的俩边格的平均数；三阶本质只有一种"
        },
        {
          "t": "li",
          "v": "九数等差即标准幻方逐格换成 $c+d(x-5)$：角偏移是奇数倍 $d,3d$"
        },
        {
          "t": "li",
          "v": "边中格偏移只能是偶数倍 $2d,4d$，用来判某数能否落在角上"
        },
        {
          "t": "li",
          "v": "罗伯法：$1$ 放首行正中，一律向右上，撞已填则下移；只适奇数阶"
        },
        {
          "t": "li",
          "v": "四阶：顺填 $1\\sim16$ 后把两条对角线上的 $x$ 换成 $17-x$，幻和 $34$"
        },
        {
          "t": "tip",
          "v": "识别信号：行列对角线和相等、给幻和求中心或给中心求和"
        },
        {
          "t": "warn",
          "v": "易错：九数总和 $45$ 不是幻和，$S=45\\div3=15$；对称两格和是 $2c$"
        }
      ]
    },
    {
      "id": "ocb-number-array",
      "title": "数阵图",
      "span": 1,
      "pair_with": "ocb-magic-square",
      "blocks": [
        {
          "t": "sec",
          "v": "重数公式"
        },
        {
          "t": "li",
          "v": "动手前三问：线有几条、每条几个数、每格被几条线共用"
        },
        {
          "t": "li",
          "v": "把各线的和相加：被 $r$ 条线共用的数多算 $r-1$ 次"
        },
        {
          "t": "li",
          "v": "辐射型：中心被 $m$ 条线共用，$mS=T+(m-1)c$"
        },
        {
          "t": "li",
          "v": "封闭型：顶点被两条边共用，$mS=T+O$，$O$ 为顶点和"
        },
        {
          "t": "li",
          "v": "重数处处相同则 $S$ 由 $T$ 锁死：正方体每顶属三面，$6S=3T$"
        },
        {
          "t": "sec",
          "v": "求值与套路"
        },
        {
          "t": "li",
          "v": "求极值三步：定 $O$ 的上下界 → 用整除性筛 → 再构造"
        },
        {
          "t": "li",
          "v": "公式只给必要条件，必须验余下的数能否配对，配不成即无解"
        },
        {
          "t": "li",
          "v": "重数不齐就多列一式：幻方 $3S=T$ 与 $4S=T+3c$ 相减得 $c=S\\div3$"
        },
        {
          "t": "li",
          "v": "只求某处之和：含它的线单独相加，或用全线和减已知部分"
        },
        {
          "t": "tip",
          "v": "识别信号：每条线和相等、每数恰用一次、问最大最小或能否"
        },
        {
          "t": "warn",
          "v": "易错：重数数错（三角形顶点只多算一次，$3S=T+O$）；要逐线验算"
        }
      ]
    },
    {
      "id": "ocb-construction",
      "title": "构造与论证",
      "span": 1,
      "pair_with": "ocb-extremum",
      "blocks": [
        {
          "t": "sec",
          "v": "抽屉原理"
        },
        {
          "t": "li",
          "v": "抽屉要自己造：按余数分类、按配对分组、按每 $m$ 个连续数切段"
        },
        {
          "t": "li",
          "v": "$N$ 个物体入 $k$ 个抽屉，必有一抽屉不少于 $N\\div k$ 向上取整"
        },
        {
          "t": "li",
          "v": "容量不等：各抽屉不达标存量取 $m-1$ 与实存量的较小者，保证数是其和加 $1$"
        },
        {
          "t": "sec",
          "v": "极端与反证"
        },
        {
          "t": "li",
          "v": "最大数最大就让其余尽量小；极端只给界，必须补一份达到界的构造"
        },
        {
          "t": "li",
          "v": "计数上界：$k$ 个用与不用的开关至多造出 $2^k$ 种结果"
        },
        {
          "t": "li",
          "v": "两端夹逼：先证不可能超过 $M$，再构造恰好等于 $M$"
        },
        {
          "t": "li",
          "v": "反证第一句必须否定结论：「至少一个」的反面是「一个也没有」"
        },
        {
          "t": "li",
          "v": "取最极端的反例再调整一步，造出更极端仍合法者，矛盾立刻出现"
        },
        {
          "t": "li",
          "v": "矛盾从四处冒：余数、奇偶、总数与极端本身"
        },
        {
          "t": "li",
          "v": "标准路线：论证上界再给构造，两头咬合才算做完"
        },
        {
          "t": "tip",
          "v": "识别信号：至少取几个才保证、最多最少是多少、能否、证明不存在"
        },
        {
          "t": "warn",
          "v": "易错：把「保证」按运气好算，要走最不利；只构造不证上界"
        }
      ]
    },
    {
      "id": "ocb-optimization",
      "title": "统筹优化",
      "span": 1,
      "pair_with": null,
      "blocks": [
        {
          "t": "sec",
          "v": "排队"
        },
        {
          "t": "fx",
          "v": "T=nt_1+(n-1)t_2+\\cdots+t_n"
        },
        {
          "t": "li",
          "v": "位置权重从前到后是 $n,n-1,\\dots,1$，所以用时短的排前面"
        },
        {
          "t": "li",
          "v": "只统计等待时权重变 $n-1,\\dots,0$，排序不变，结果少一个总工时"
        },
        {
          "t": "li",
          "v": "两个窗口要尽量均分人数，$3+3$ 优于 $4+2$，再大权重配短用时"
        },
        {
          "t": "sec",
          "v": "烙饼与过河"
        },
        {
          "t": "li",
          "v": "锅一次 $m$ 张、每面 $a$ 分：轮数至少取 $2$ 与「总面数 $\\div m$」的较大者，靠轮换可达"
        },
        {
          "t": "li",
          "v": "过河：$f$ 趟去、$f-1$ 趟回最多送 $f+1$ 人，故趟数下界 $n-1$；回程派最快者"
        },
        {
          "t": "li",
          "v": "送最慢两人：取 $2t_1+t_{n-1}+t_n$ 与 $t_1+2t_2+t_n$ 中的较小者"
        },
        {
          "t": "sec",
          "v": "双机流水"
        },
        {
          "t": "li",
          "v": "约翰逊法则：每次取剩余件中两机时间的较小值，在 A 排最前，在 B 排最后"
        },
        {
          "t": "li",
          "v": "通用下界：$\\sum a_i+\\min b_i$ 与 $\\sum b_i+\\min a_i$；固定顺序工期用 $C_{\\max}=\\max_j(\\sum_{i\\le j}a_i+\\sum_{i\\ge j}b_i)$ 验算"
        },
        {
          "t": "tip",
          "v": "识别信号：一个窗口、一次最多几张、灯要送回、两人按慢者计时、先 A 后 B"
        },
        {
          "t": "warn",
          "v": "易错：只写下界不构造；过河漏算回程；总完成时间与总等待差一个总工时"
        }
      ]
    },
    {
      "id": "ocb-division-cryptarithm",
      "title": "除法数字谜",
      "span": 1,
      "pair_with": "ocb-cryptarithm",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "fx",
          "v": "a=bq+r,\\quad 0\\le r<b"
        },
        {
          "t": "li",
          "v": "两道闸门：余数必须小于除数，商每位是 $0\\sim9$ 且首位非 $0$"
        },
        {
          "t": "li",
          "v": "两位商：$a=10P_1+P_2+r$，第二个部分积比第一个低一位"
        },
        {
          "t": "li",
          "v": "部分积是除数 $\\times$ 商的那一位，故除数是各部分积的公因数"
        },
        {
          "t": "sec",
          "v": "推导顺序"
        },
        {
          "t": "li",
          "v": "露两个分积：先求最大公因数，再用「商那位是一位数」筛，最后验 $r<b$"
        },
        {
          "t": "li",
          "v": "两部分积之比即 $q_1:q_2$，可先定商的两位再定除数"
        },
        {
          "t": "li",
          "v": "字母题先位值展开 $\\overline{ABC}=100A+10B+C$，同字母同数字、首位非 $0$"
        },
        {
          "t": "li",
          "v": "弃九：数与各位数字和模 $9$ 同余，先压范围再分类枚举"
        },
        {
          "t": "li",
          "v": "商中间有 $0$：落下一位不够除就写 $0$，前后两段分开算"
        },
        {
          "t": "li",
          "v": "先硬后软：有公因数锁除数，有数字和锁范围，都没有才逐位试商"
        },
        {
          "t": "tip",
          "v": "识别信号：只露出部分积、给数字和或「数字各用一次」、带余竖式"
        },
        {
          "t": "warn",
          "v": "易错：部分积按位值加不是直接相加；余数最大是 $b-1$ 不是 $b$"
        }
      ]
    },
    {
      "id": "ocb-cryptarithm",
      "title": "数字谜",
      "span": 1,
      "pair_with": "ocb-division-cryptarithm",
      "blocks": [
        {
          "t": "sec",
          "v": "列等式"
        },
        {
          "t": "li",
          "v": "每列：本列数字和 $+$ 低位进位 $=$ 本列结果 $+10\\times$ 新进位"
        },
        {
          "t": "li",
          "v": "进位上界：两数相加最多进 $1$，三数相加最多进 $2$，乘 $d$ 最多进 $d-1$"
        },
        {
          "t": "li",
          "v": "位数变多即最高位进了位：两个三位数相加得四位数，千位必是 $1$"
        },
        {
          "t": "li",
          "v": "减法遇连续借位，把每列借位记成变量 $c_i$ 逐列写，别心算"
        },
        {
          "t": "sec",
          "v": "首尾与变形"
        },
        {
          "t": "li",
          "v": "通用开局：用位数卡首位、用个位定末位，首尾互相夹逼"
        },
        {
          "t": "li",
          "v": "倒序数：差 $999(A-D)+90(B-C)$ 必为 $9$ 的倍数，和必为 $11$ 的倍数"
        },
        {
          "t": "li",
          "v": "横式题先位值展开消元，化成整除式后按因数分家分类"
        },
        {
          "t": "li",
          "v": "标准路线：定首位 → 定末位 → 逐列回推 → 代回验算，出矛盾即回头"
        },
        {
          "t": "li",
          "v": "先攻信息最密的一列（一般个位或最高位），再看进位被什么卡住"
        },
        {
          "t": "li",
          "v": "问最大最小共几种：先列方程定出全部候选，再用极端原理挑"
        },
        {
          "t": "tip",
          "v": "识别信号：字母汉字方框竖式、积恰是原数的倒序、数字各用一次"
        },
        {
          "t": "warn",
          "v": "易错：$\\overline{AB}$ 是 $10A+B$ 不是乘积；三数相加可能进 $2$；首位不能为 $0$"
        }
      ]
    },
    {
      "id": "ocb-extremum",
      "title": "最值问题",
      "span": 1,
      "pair_with": "ocb-construction",
      "blocks": [
        {
          "t": "sec",
          "v": "两条主干"
        },
        {
          "t": "fx",
          "v": "ab\\le\\frac{S^2}{4},\\quad a+b\\ge2\\sqrt{P}"
        },
        {
          "t": "li",
          "v": "$a+b=S$ 时积最大、$ab=P$ 时和最小，都让两数尽量相等"
        },
        {
          "t": "li",
          "v": "反过来求积最小、求和最大，就让两数尽量悬殊"
        },
        {
          "t": "li",
          "v": "搬 $1$ 引理：$(a+1)(b-1)-ab=b-a-1>0$，差 $\\ge2$ 就还能调优"
        },
        {
          "t": "li",
          "v": "整数取等：$S$ 偶取两个 $S\\div2$；$S$ 奇取相邻两数，最大积 $(S^2-1)\\div4$"
        },
        {
          "t": "li",
          "v": "先看不变量是和定还是积定；两者都不定就只能分类枚举"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "配凑定和：系数要并进数里，$2x+y=24$ 视为 $2x$ 与 $y$，最值在 $2x=y=12$"
        },
        {
          "t": "li",
          "v": "多变量：和定时乘积最大的一组数只能相差 $0$ 或 $1$，用商余定个数"
        },
        {
          "t": "li",
          "v": "整数拆分求积最大：尽量全拆成 3，余 1 时改凑两个 2，余 2 时留一个 2"
        },
        {
          "t": "li",
          "v": "上界加构造：先证不可能超过 $M$，再举出恰好达到 $M$ 的选法"
        },
        {
          "t": "tip",
          "v": "识别信号：和一定求积最大、面积一定求周长最小、最多至少、怎样最省"
        },
        {
          "t": "warn",
          "v": "易错：公式给的是实数答案，整数题要在最近的一对因数里挑并验相邻"
        }
      ]
    },
    {
      "id": "ocb-game-strategy",
      "title": "游戏策略",
      "span": 1,
      "pair_with": "ocb-logic",
      "blocks": [
        {
          "t": "sec",
          "v": "胜负态"
        },
        {
          "t": "li",
          "v": "必胜态 W：能一步把对手送进 L；必败态 L：怎么走都送对手进 W"
        },
        {
          "t": "li",
          "v": "终点先定死：取最后者胜时 $0$ 枚是 L，取最后者输时 $0$ 枚是 W"
        },
        {
          "t": "sec",
          "v": "四个模型"
        },
        {
          "t": "li",
          "v": "补足法：每次 $1\\sim m$ 枚就凑 $m+1$，倍数是 L，非倍数先取走余数"
        },
        {
          "t": "li",
          "v": "应对要说全：对方取 $k$ 枚，你就取 $m+1-k$ 枚，最后一轮由你收尾"
        },
        {
          "t": "li",
          "v": "镜像：对方在哪取 $k$ 枚，你在对称位取 $k$ 枚，每应一次对称恢复"
        },
        {
          "t": "li",
          "v": "对称要合格：偶数格棋盘中缝两侧相邻，镜像失效，需换对称方式"
        },
        {
          "t": "li",
          "v": "周期法：最近连续 $r$ 个 W/L 组成状态；状态重复且转移确定才进入周期"
        },
        {
          "t": "li",
          "v": "终点反转：L 变成 $m+1$ 的倍数加 $1$；换了取法集合必须重算"
        },
        {
          "t": "li",
          "v": "两堆各取 $1\\sim m$：L 当且仅当两堆余数模 $m+1$ 相同"
        },
        {
          "t": "tip",
          "v": "识别信号：轮流取、必胜、最多取几枚、两堆、圆桌棋盘、不能动者输"
        },
        {
          "t": "warn",
          "v": "易错：余数为 $0$ 就是 L，别硬凑；败版不能套胜版公式，须重算"
        }
      ]
    },
    {
      "id": "ocb-logic",
      "title": "逻辑推理",
      "span": 1,
      "pair_with": "ocb-game-strategy",
      "blocks": [
        {
          "t": "sec",
          "v": "三类题"
        },
        {
          "t": "li",
          "v": "身份型：每人要么句句真，要么句句假，真假被身份绑死"
        },
        {
          "t": "li",
          "v": "计数型：只说「恰有 $k$ 句真」，真假由事实定，与身份无关"
        },
        {
          "t": "li",
          "v": "对应型：人、城市、名次一一对应，条件多为「是/不是」"
        },
        {
          "t": "li",
          "v": "分水岭：「乙说谎」身份型译「乙是假话者」，计数型只译「乙这句假」"
        },
        {
          "t": "sec",
          "v": "三招"
        },
        {
          "t": "li",
          "v": "假设：候选有限（至多 $2^n$、$n!$ 种），逐个代回数真话数"
        },
        {
          "t": "li",
          "v": "矛盾：一对否定句先占一句真，$k$ 句真只需再凑 $k-1$"
        },
        {
          "t": "li",
          "v": "表格：每行每列恰一个 ✓；先填信息最密一栏，条件要反向用"
        },
        {
          "t": "sec",
          "v": "三个变形"
        },
        {
          "t": "li",
          "v": "插普通人：身份与真假脱钩，答案常不唯一，多问「谁一定」"
        },
        {
          "t": "li",
          "v": "每人恰对一句：挑能一次定死数值的那句二分，真假相反牵出全链"
        },
        {
          "t": "li",
          "v": "自指计数：$k$ 人说谎则真话者仅 1 人，故 $n-k=1$（$k=0$ 矛盾）"
        },
        {
          "t": "tip",
          "v": "识别信号：只有一句真、恰有 $k$ 句真、每人说对一句、一人一项"
        },
        {
          "t": "warn",
          "v": "易错：矛盾对只定一真一假；「丙在说谎」≠假话者；假设不证唯一"
        }
      ]
    }
  ]
}
