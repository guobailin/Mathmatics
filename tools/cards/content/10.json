{
  "module_dir": "10-奥数-行程",
  "items": [
    {
      "id": "otr-bus-departure",
      "title": "发车问题",
      "span": 1,
      "pair_with": "otr-proportional",
      "blocks": [
        {
          "t": "sec",
          "v": "车距三式"
        },
        {
          "t": "fx",
          "v": "L=(v+u)t_1=(v-u)t_2=vT"
        },
        {
          "t": "li",
          "v": "$t_1$ 为迎面遇车间隔，$t_2$ 为同向追车间隔，故 $t_2>t_1$；$T$ 为发车间隔"
        },
        {
          "t": "li",
          "v": "车距 $L$ 对谁都一样，变的是人与车流的相对速度"
        },
        {
          "t": "sec",
          "v": "反求"
        },
        {
          "t": "fx",
          "v": "T=\\frac{2t_1t_2}{t_1+t_2},\\qquad \\frac vu=\\frac{t_1+t_2}{t_2-t_1}"
        },
        {
          "t": "li",
          "v": "$T$ 是 $t_1,t_2$ 的调和平均，不是算术平均"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "$u=v$ 追不上；$u>v$ 反是人追车，间隔 $\\frac{L}{u-v}$"
        },
        {
          "t": "li",
          "v": "柳卡图（位置—时间图）：车是平行直线，交点即相遇，人在车上尤宜"
        },
        {
          "t": "tip",
          "v": "识别信号：每隔几分钟发（遇）一辆、两端同时发车"
        },
        {
          "t": "warn",
          "v": "易错：反求 $T$ 取算术平均；把迎面间隔算成 $\\frac{L}{v-u}$"
        }
      ]
    },
    {
      "id": "otr-multi-person",
      "title": "多人相遇",
      "span": 1,
      "pair_with": "otr-multi-meeting",
      "blocks": [
        {
          "t": "sec",
          "v": "拆对"
        },
        {
          "t": "li",
          "v": "三人拆成两两：每对只看两人速度与全程，第三人只是路标"
        },
        {
          "t": "sec",
          "v": "判定"
        },
        {
          "t": "li",
          "v": "同端 $(v_1\\pm v_2)t=2kS$；两端 $(v_1\\pm v_2)t=(2k-1)S$"
        },
        {
          "t": "li",
          "v": "每对各含和、差两族，只列一族必漏掉一半相遇"
        },
        {
          "t": "sec",
          "v": "常用结论"
        },
        {
          "t": "li",
          "v": "时间差：若 $v_甲>v_乙$，且 $t_1$ 为丙先遇甲的时刻，则 $\\Delta t=\\frac{(v_甲-v_乙)t_1}{v_丙+v_乙}$（丙随后遇乙）"
        },
        {
          "t": "li",
          "v": "折返：距 $B$ 为 $x$ 处相遇，$\\frac{S+x}{S-x}=\\frac{v_甲}{v_乙}$"
        },
        {
          "t": "li",
          "v": "三人同地：取共用同一人的两对时刻表之交集"
        },
        {
          "t": "tip",
          "v": "识别信号：三人、同时出发、第几次、往返 → 拆对、列时刻表、取交集"
        },
        {
          "t": "warn",
          "v": "易错：把三速度相加；每对只列一族"
        }
      ]
    },
    {
      "id": "otr-clock",
      "title": "时钟问题",
      "span": 1,
      "pair_with": "otr-circular-track",
      "blocks": [
        {
          "t": "sec",
          "v": "基本速度"
        },
        {
          "t": "fx",
          "v": "v_{分}=6\\degree/\\text{min},\\quad v_{时}=0.5\\degree/\\text{min}"
        },
        {
          "t": "li",
          "v": "追及相对速度差 $5.5\\degree$/分"
        },
        {
          "t": "li",
          "v": "$H$ 为 12 小时制小时数（$0\\le H<12$），$M$ 为分钟数（$0\\le M<60$）；$\\Delta$ 为初始角差"
        },
        {
          "t": "sec",
          "v": "夹角与时刻"
        },
        {
          "t": "fx",
          "v": "\\theta=|30H-5.5M|"
        },
        {
          "t": "fx",
          "v": "|5.5t-\\Delta|=\\alpha"
        },
        {
          "t": "li",
          "v": "夹角取较小角，超过 $180\\degree$ 取补角"
        },
        {
          "t": "sec",
          "v": "周期与计数"
        },
        {
          "t": "fx",
          "v": "\\frac{720}{11}\\ \\text{分重合一次},\\quad \\frac{360}{11}\\ \\text{分成直角一次}"
        },
        {
          "t": "li",
          "v": "每扫满一圈：直角 $2$ 次、重合 $1$ 次"
        },
        {
          "t": "li",
          "v": "快慢钟：先在钟面时间里算角，再换标准时间"
        },
        {
          "t": "li",
          "v": "计数先确认是否把校准时刻/区间起点的初始重合计入"
        },
        {
          "t": "tip",
          "v": "识别信号：重合、成直角、一直线、夹角几度、快慢钟"
        },
        {
          "t": "warn",
          "v": "易错：以为时针不动；两解只取一个"
        }
      ]
    },
    {
      "id": "otr-train-bridge",
      "title": "火车过桥",
      "span": 1,
      "pair_with": "otr-train-chase",
      "blocks": [
        {
          "t": "sec",
          "v": "三个路程"
        },
        {
          "t": "li",
          "v": "完全通过：车头走 $B+L$，$t=\\frac{B+L}{v}$"
        },
        {
          "t": "li",
          "v": "完全在桥上：车头走 $B-L$，$t=\\frac{B-L}{v}$；$B>L$ 为正时长，$B=L$ 为 0，$B<L$ 不可能"
        },
        {
          "t": "li",
          "v": "过一个点（树、电线杆）：车头走 $L$，$t=\\frac{L}{v}$"
        },
        {
          "t": "li",
          "v": "过走动的人：相对速度 $v_{车}\\pm v_{人}$，相对路程仍是一个车长"
        },
        {
          "t": "sec",
          "v": "反求与轴"
        },
        {
          "t": "li",
          "v": "同一列车过两桥：$t_1-t_2=\\frac{B_1-B_2}{v}$，先消车长得速度"
        },
        {
          "t": "tip",
          "v": "识别信号：通过、完全在、错车、超过、从窗口看到 → 只盯车头"
        },
        {
          "t": "warn",
          "v": "易错：把火车当点用 $\\frac{B}{v}$；相向错车却用速度差"
        }
      ]
    },
    {
      "id": "otr-variable-speed",
      "title": "变速问题",
      "span": 1,
      "pair_with": "otr-basic-average",
      "blocks": [
        {
          "t": "sec",
          "v": "切段"
        },
        {
          "t": "li",
          "v": "以变速时刻为界切段，段内 $s=vt$，段间路程、时间分别相加"
        },
        {
          "t": "fx",
          "v": "\\overline{v}=\\frac{s_1+s_2+\\cdots}{t_1+t_2+\\cdots}"
        },
        {
          "t": "sec",
          "v": "提速换算"
        },
        {
          "t": "li",
          "v": "提速 $r$（$r$ 用小数表示）：时间变为原来的 $\\frac{1}{1+r}$，节省 $\\frac{r}{1+r}$"
        },
        {
          "t": "li",
          "v": "提速 $20\\%$ 省 $\\frac16$，$25\\%$ 省 $\\frac15$，$50\\%$ 省 $\\frac13$"
        },
        {
          "t": "li",
          "v": "给时间差时设计划时间 $T$ 最省力，不必设路程"
        },
        {
          "t": "tip",
          "v": "识别信号：先…后…、前一半路程或时间、提速百分之几、往返"
        },
        {
          "t": "warn",
          "v": "易错：提速 $20\\%$ 以为省 $20\\%$；往返平均速度分母漏乘 $2$"
        }
      ]
    },
    {
      "id": "otr-multi-meeting",
      "title": "多次相遇",
      "span": 1,
      "pair_with": "otr-multi-person",
      "blocks": [
        {
          "t": "sec",
          "v": "核心结论"
        },
        {
          "t": "li",
          "v": "两端相向迎面族：第 $n$ 次合走 $(2n-1)S$"
        },
        {
          "t": "fx",
          "v": "t_n=\\frac{(2n-1)S}{v_甲+v_乙}"
        },
        {
          "t": "li",
          "v": "同端同向折返：迎面族 $(v_1+v_2)t=2kS$；追及族 $|v_1-v_2|t=2kS$"
        },
        {
          "t": "li",
          "v": "总次数：合并两族时刻，同一端点时刻只计一次"
        },
        {
          "t": "sec",
          "v": "位置换算"
        },
        {
          "t": "li",
          "v": "走 $x$ 米取余 $r$（模 $2S$）：$r\\le S$ 位置为 $r$，否则为 $2S-r$"
        },
        {
          "t": "li",
          "v": "追及族：$(v_甲-v_乙)t=(2k-1)S$，两族时刻合并后去重"
        },
        {
          "t": "sec",
          "v": "辨析"
        },
        {
          "t": "li",
          "v": "环形：第 $n$ 次合走（或差）$n$ 个周长"
        },
        {
          "t": "li",
          "v": "反求 $S$：先写该次总路程，再分它落在第几个 $2S$ 内"
        },
        {
          "t": "tip",
          "v": "识别信号：到达对方出发点后立即返回、第二次相遇、相遇点距 A"
        },
        {
          "t": "warn",
          "v": "易错：第 $n$ 次路程和写成 $nS$；把路程直接当位置"
        }
      ]
    },
    {
      "id": "otr-proportional",
      "title": "比例行程",
      "span": 1,
      "pair_with": "otr-bus-departure",
      "blocks": [
        {
          "t": "sec",
          "v": "三量比例"
        },
        {
          "t": "fx",
          "v": "s_1:s_2=(v_1t_1):(v_2t_2)"
        },
        {
          "t": "li",
          "v": "时间相同 $s_1:s_2=v_1:v_2$；路程相同 $v_1:v_2=t_2:t_1$"
        },
        {
          "t": "li",
          "v": "速度相同 $s_1:s_2=t_1:t_2$"
        },
        {
          "t": "sec",
          "v": "常用结论"
        },
        {
          "t": "li",
          "v": "相遇时时间相同，路程比等于速度比，路程差比等于速度差比"
        },
        {
          "t": "li",
          "v": "猎狗追兔：速度 = 步频 $\\times$ 步长，两比相乘得速度比"
        },
        {
          "t": "li",
          "v": "相遇后变速：以相遇点为界换成新速度比"
        },
        {
          "t": "sec",
          "v": "份数法"
        },
        {
          "t": "li",
          "v": "先问哪个量相同，再设份数，用几份对应几千米定出一份"
        },
        {
          "t": "li",
          "v": "折返题先判谁先到端点、相遇在折返前还是折返后"
        },
        {
          "t": "tip",
          "v": "识别信号：比、同时、相遇、往返、提前迟到、多行几千米"
        },
        {
          "t": "warn",
          "v": "易错：速度 $5:4$ 就把时间也写 $5:4$"
        }
      ]
    },
    {
      "id": "otr-train-chase",
      "title": "火车追及",
      "span": 1,
      "pair_with": "otr-train-bridge",
      "blocks": [
        {
          "t": "sec",
          "v": "基本模型"
        },
        {
          "t": "fx",
          "v": "L_1+L_2=(v_1-v_2)t_{超}"
        },
        {
          "t": "li",
          "v": "同向完全超车，快车速度 $v_1>v_2$；$L_1,L_2$ 分别为两车长度"
        },
        {
          "t": "li",
          "v": "有初始间距 $S$ 时总相对路程再加 $S$"
        },
        {
          "t": "sec",
          "v": "比例与联立"
        },
        {
          "t": "li",
          "v": "位移比等于时间比：超车两段位移依次为 $L_2$、$L_1$"
        },
        {
          "t": "fx",
          "v": "\\frac{t_{超}}{t_{错}}=\\frac{v_1+v_2}{v_1-v_2}"
        },
        {
          "t": "li",
          "v": "由时间比读出速度比，再配过桥式 $L_1+B=v_1T$ 定车长"
        },
        {
          "t": "sec",
          "v": "事件与区间"
        },
        {
          "t": "li",
          "v": "车头平齐位移 $L_2$，完全超过 $L_1+L_2$，车尾平齐 $L_1$"
        },
        {
          "t": "li",
          "v": "快车实际路程用 $v_1$ 乘总时间，不能用速度差"
        },
        {
          "t": "li",
          "v": "过车上的人：相对路程只取 $l_{车}$，不是车长和"
        },
        {
          "t": "tip",
          "v": "识别信号：超车、车头平齐、从窗口看到、另一列车"
        },
        {
          "t": "warn",
          "v": "易错：追及只算快车车长；同向却用速度和"
        }
      ]
    },
    {
      "id": "otr-basic-average",
      "title": "基本公式与平均速度",
      "span": 1,
      "pair_with": "otr-variable-speed",
      "blocks": [
        {
          "t": "sec",
          "v": "两个式子"
        },
        {
          "t": "fx",
          "v": "s_{和}=v_{和}t_{和},\\quad s_{差}=v_{差}t_{差};\\quad t=s\\div v"
        },
        {
          "t": "li",
          "v": "$s_{和}$ 是两人路程和，$s_{差}$ 是路程差，二者不是同一个量"
        },
        {
          "t": "fx",
          "v": "\\overline{v}=\\frac{s_1+s_2+\\cdots}{t_1+t_2+\\cdots}"
        },
        {
          "t": "sec",
          "v": "两种平均"
        },
        {
          "t": "li",
          "v": "两段等时间：$\\overline{v}=\\frac{v_1+v_2}{2}$（算术平均）"
        },
        {
          "t": "li",
          "v": "两段等路程：$\\overline{v}=\\frac{2v_1v_2}{v_1+v_2}$（调和平均，更小）"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "fx",
          "v": "t_1:t_2=(v_2-\\overline{v}):(\\overline{v}-v_1)"
        },
        {
          "t": "li",
          "v": "已知 $\\overline{v}$ 反求：设时间不设路程，用上式定时间比"
        },
        {
          "t": "tip",
          "v": "识别信号：往返、原路返回、一半时间或一半路程、停留"
        },
        {
          "t": "warn",
          "v": "易错：等路程取算术平均；往返平均速度分母只算单程"
        }
      ]
    },
    {
      "id": "otr-escalator",
      "title": "扶梯问题",
      "span": 1,
      "pair_with": "otr-boat-stream",
      "blocks": [
        {
          "t": "sec",
          "v": "三个量"
        },
        {
          "t": "li",
          "v": "静止可见 $N$ 级，梯速 $v$，人相对梯面步速 $u$"
        },
        {
          "t": "fx",
          "v": "N=t(u\\pm v)=tu\\pm tv,\\quad u>v"
        },
        {
          "t": "li",
          "v": "$N$ 由人走的与梯子送的两部分组成"
        },
        {
          "t": "li",
          "v": "人边走边数的是 $tu$，梯子另送 $tv$，步数不是 $N$"
        },
        {
          "t": "sec",
          "v": "常用公式"
        },
        {
          "t": "fx",
          "v": "N=\\frac{2ab}{a+b},\\qquad \\frac vu=\\frac{b-a}{a+b}"
        },
        {
          "t": "li",
          "v": "$a,b$ 为同一人上行、下行各数到的级数（$a<b$）"
        },
        {
          "t": "li",
          "v": "两端同时出发相遇：$N=a+b$"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "同向追及、相向相遇：梯速抵消，相对速度是 $u_1-u_2$ 或 $u_1+u_2$"
        },
        {
          "t": "tip",
          "v": "识别信号：边走边数、静止时可见几级、向上或向下走、转身"
        },
        {
          "t": "warn",
          "v": "易错：把数到的级数当 $N$；逆行写成 $v-u$"
        }
      ]
    },
    {
      "id": "otr-boat-stream",
      "title": "流水行船",
      "span": 1,
      "pair_with": "otr-escalator",
      "blocks": [
        {
          "t": "sec",
          "v": "速度合成"
        },
        {
          "t": "li",
          "v": "顺水 $v_{船}+v_{水}$，逆水 $v_{船}-v_{水}$（须 $v_{船}>v_{水}$）"
        },
        {
          "t": "fx",
          "v": "v_{船}=\\frac{v_{顺}+v_{逆}}{2},\\quad v_{水}=\\frac{v_{顺}-v_{逆}}{2}"
        },
        {
          "t": "li",
          "v": "改以水为参照：水静止，漂浮物不动，船恒以 $v_{船}$ 行"
        },
        {
          "t": "li",
          "v": "同时出发的水中相遇与追及不计水速，只看各自 $v_{船}$"
        },
        {
          "t": "sec",
          "v": "常用结论"
        },
        {
          "t": "li",
          "v": "同路程往返：$t_{顺}:t_{逆}=v_{逆}:v_{顺}$（时间与速度反比）"
        },
        {
          "t": "li",
          "v": "追漂浮物：离开多久就追多久，与水速大小无关"
        },
        {
          "t": "fx",
          "v": "\\overline{v}=\\frac{2v_{顺}v_{逆}}{v_{顺}+v_{逆}}=v_{船}-\\frac{v_{水}^2}{v_{船}}"
        },
        {
          "t": "li",
          "v": "往返平均速度恒小于 $v_{船}$，水速越大被拖得越慢"
        },
        {
          "t": "warn",
          "v": "易错：求水速忘除以 $2$；往返平均取算术平均"
        }
      ]
    },
    {
      "id": "otr-circular-track",
      "title": "环形跑道",
      "span": 1,
      "pair_with": "otr-clock",
      "blocks": [
        {
          "t": "sec",
          "v": "基本模型"
        },
        {
          "t": "fx",
          "v": "t=\\frac{nL}{v_1+v_2}\\ (\\text{反向}),\\quad t=\\frac{nL}{v_1-v_2}\\ (\\text{同向})"
        },
        {
          "t": "li",
          "v": "默认同地同时出发，且同向追及时 $v_1>v_2$；反向用速度和，同向用速度差"
        },
        {
          "t": "li",
          "v": "反向合走一圈相遇一次，同向多跑一圈追上一次"
        },
        {
          "t": "sec",
          "v": "位置与周期"
        },
        {
          "t": "li",
          "v": "位置就是路程除以 $L$ 的余数，余 $0$ 即回出发点"
        },
        {
          "t": "li",
