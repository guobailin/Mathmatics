{
  "module_dir": "09-奥数-几何",
  "items": [
    {
      "id": "oge-bird-head",
      "title": "鸟头模型",
      "span": 1,
      "pair_with": "oge-similarity",
      "blocks": [
        {
          "t": "fig",
          "v": "bird-head"
        },
        {
          "t": "sec",
          "v": "核心结论"
        },
        {
          "t": "fx",
          "v": "\\frac{S_1}{S_2}=\\frac{AD}{AB}\\times\\frac{AE}{AC}"
        },
        {
          "t": "li",
          "v": "两三角形共角（公共角、对顶角、直角）或互补，小三角咬在大三角一角上"
        },
        {
          "t": "li",
          "v": "四个量两两落在同一直线：$AD$ 配 $AB$，$AE$ 配 $AC$，不可交叉"
        },
        {
          "t": "li",
          "v": "互补角把一边反向延长即化成等角，面积比仍是夹边乘积比"
        },
        {
          "t": "sec",
          "v": "变形与逆用"
        },
        {
          "t": "li",
          "v": "对顶角型：交叉两三角形面积比 $=OA\\times OC:OB\\times OD$"
        },
        {
          "t": "li",
          "v": "与同高联用：先鸟头求大块，再同高细分，两次比值相乘"
        },
        {
          "t": "li",
          "v": "逆用：未知边比 = 面积比 $\\div$ 已知边比；求四边形用整体减空白"
        },
        {
          "t": "tip",
          "v": "识别信号：一个角被两个三角形共用，且两条夹边上都有分点"
        },
        {
          "t": "sec",
          "v": "易错"
        },
        {
          "t": "li",
          "v": "$AD:DB=1:3$ 时 $AD:AB=1:4$，先换算成占全长再相乘"
        },
        {
          "t": "warn",
          "v": "易错：只乘一条边；分点都在线段上时比值必小于 $1$"
        }
      ]
    },
    {
      "id": "oge-swallow-tail",
      "title": "燕尾模型",
      "span": 1,
      "pair_with": "oge-area-ratio",
      "blocks": [
        {
          "t": "fig",
          "v": "swallow-tail"
        },
        {
          "t": "sec",
          "v": "核心结论"
        },
        {
          "t": "li",
          "v": "记 $x=S_{PBC}$、$y=S_{PCA}$、$z=S_{PAB}$（$P$ 在三角形内）"
        },
        {
          "t": "fx",
          "v": "\\frac{BD}{DC}=\\frac{z}{y},\\quad \\frac{CE}{EA}=\\frac{x}{z},\\quad \\frac{AF}{FB}=\\frac{y}{x}"
        },
        {
          "t": "fx",
          "v": "\\frac{BD}{DC}\\cdot\\frac{CE}{EA}\\cdot\\frac{AF}{FB}=1"
        },
        {
          "t": "sec",
          "v": "常用套路"
        },
        {
          "t": "li",
          "v": "双燕尾：由两条边比定 $x:y:z$，再按 $x+y+z=S$ 分配"
        },
        {
          "t": "li",
          "v": "逆用：已知面积直接读线段比；贴边小块先用同高拆开"
        },
        {
          "t": "li",
          "v": "中点给出两组等面积，与燕尾联立可定线段比"
        },
        {
          "t": "tip",
          "v": "识别：三角形内一点 + 过顶点的连线，先找连线两侧那两块"
        },
        {
          "t": "sec",
          "v": "易错"
        },
        {
          "t": "li",
          "v": "分母是另一段不是整条；$BD$ 配含 $B$ 的 $z$，$DC$ 配含 $C$ 的 $y$"
        },
        {
          "t": "warn",
          "v": "易错：$S_{ABP}=S_{ABD}-S_{PBD}$，必须相减，不能相加"
        }
      ]
    },
    {
      "id": "oge-butterfly",
      "title": "蝴蝶模型",
      "span": 1,
      "pair_with": "oge-equal-area",
      "blocks": [
        {
          "t": "fig",
          "v": "butterfly-model"
        },
        {
          "t": "sec",
          "v": "乘积式"
        },
        {
          "t": "li",
          "v": "记四块：上块 $S_1$、右翅 $S_2$、下块 $S_3$、左翅 $S_4$"
        },
        {
          "t": "fx",
          "v": "S_1\\times S_3=S_2\\times S_4"
        },
        {
          "t": "li",
          "v": "任意四边形都成立，只用共高；知三块可求第四块"
        },
        {
          "t": "li",
          "v": "$AO:OC=(S_1+S_2):(S_4+S_3)$，即同侧两块相加再比"
        },
        {
          "t": "sec",
          "v": "梯形份数"
        },
        {
          "t": "li",
          "v": "条件：$AB\\parallel CD$ 时两翅才相等（一般四边形不成立）"
        },
        {
          "t": "fx",
          "v": "S_1:S_3=a^2:b^2,\\quad S_1:S_2:S_3:S_4=a^2:ab:b^2:ab"
        },
        {
          "t": "li",
          "v": "设 $AB:CD=a:b$，总份数 $(a+b)^2$，定 $k$ 后分配四块"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "腰延长交于 $P$：$PA:AD=a:(b-a)$，两三角形面积比 $a^2:b^2$"
        },
        {
          "t": "li",
          "v": "和差还原：$(a+b)^2k$ 与 $(a-b)^2k$ 联立，开方再用和差求 $a:b$"
        },
        {
          "t": "tip",
          "v": "识别信号：对角线交点、梯形四块、同底共高"
        },
        {
          "t": "warn",
          "v": "易错：总份数是 $(a+b)^2$；底比 $2:3$ 对应面积比 $4:9$"
        }
      ]
    },
    {
      "id": "oge-equal-area",
      "title": "等积模型",
      "span": 1,
      "pair_with": "oge-butterfly",
      "blocks": [
        {
          "t": "fig",
          "v": "equal-area"
        },
        {
          "t": "sec",
          "v": "两条根基"
        },
        {
          "t": "fx",
          "v": "\\frac{S_{ABD}}{S_{ACD}}=\\frac{BD}{DC}"
        },
        {
          "t": "li",
          "v": "等底等高则等积；同底或同高时面积比等于另一边之比"
        },
        {
          "t": "li",
          "v": "顶点沿与底平行的直线滑动，面积不变——等积变形（拉车）"
        },
        {
          "t": "sec",
          "v": "常用结论"
        },
        {
          "t": "li",
          "v": "一半模型：平行四边形内 $E$ 在一边上，$S_{CDE}=\\frac{1}{2}S$"
        },
        {
          "t": "li",
          "v": "平行四边形内一点：$S_{ABP}+S_{CDP}=\\frac{1}{2}S$（对角两块）"
        },
        {
          "t": "li",
          "v": "设最小块为 $x$，用整体 = 部分和列方程；中点想 $1:1$"
        },
        {
          "t": "li",
          "v": "找不到共底共高，就作平行线或延长线造出等高"
        },
        {
          "t": "tip",
          "v": "识别信号：平行线、平行四边形、梯形、中点、只给面积不给长度"
        },
        {
          "t": "warn",
          "v": "易错：顶点只能沿平行线滑；面积比大底配大面积"
        }
      ]
    },
    {
      "id": "oge-similarity",
      "title": "相似模型",
      "span": 1,
      "pair_with": "oge-bird-head",
      "blocks": [
        {
          "t": "fig",
          "v": "similarity"
        },
        {
          "t": "sec",
          "v": "核心换算"
        },
        {
          "t": "fx",
          "v": "\\frac{S_1}{S_2}=k^2,\\quad \\frac{C_1}{C_2}=k"
        },
        {
          "t": "li",
          "v": "周长、对应高按 $k$ 缩放；给面积比先开方才得 $k$"
        },
        {
          "t": "sec",
          "v": "三个图形"
        },
        {
          "t": "li",
          "v": "A 字型：$DE\\parallel BC$，$\\triangle ADE\\sim\\triangle ABC$"
        },
        {
          "t": "li",
          "v": "X 字型：$AB\\parallel CD$ 交于 $O$，四块 $m^2:mn:n^2:mn$"
        },
        {
          "t": "li",
          "v": "反 A 型：$\\angle ACD=\\angle ABC$，对应错位（$D$ 配 $C$）"
        },
        {
          "t": "fx",
          "v": "AC^2=AD\\cdot AB"
        },
        {
          "t": "sec",
          "v": "常用变形"
        },
        {
          "t": "li",
          "v": "梯形只给上下两块 $a,b$：总面积 $=(\\sqrt{a}+\\sqrt{b})^2$"
        },
        {
          "t": "tip",
          "v": "识别：平行线找 A/X 型；公共角 + 一组等角想反 A 型"
        },
        {
          "t": "warn",
          "v": "易错：$k=\\frac{AD}{AB}$ 不是 $\\frac{AD}{DB}$；面积比别忘平方"
        }
      ]
    },
    {
      "id": "oge-area-ratio",
      "title": "面积比",
      "span": 1,
      "pair_with": "oge-swallow-tail",
      "blocks": [
        {
          "t": "fig",
          "v": "area-ratio"
        },
        {
          "t": "sec",
          "v": "等高模型"
        },
        {
          "t": "fx",
          "v": "\\frac{S_{ABD}}{S_{ADC}}=\\frac{BD}{DC},\\quad S_{ABD}=\\frac{BD}{BC}S_{ABC}"
        },
        {
          "t": "sec",
          "v": "等底模型"
        },
        {
          "t": "fx",
          "v": "\\frac{S_{EBC}}{S_{ABC}}=\\frac{ED}{AD}"
        },
        {
          "t": "li",
          "v": "底相同则面积比 = 高之比；$E$ 在 $AD$ 上取 $ED$ 不是 $AE$"
        },
        {
          "t": "sec",
          "v": "三个变形"
        },
        {
          "t": "li",
          "v": "共角（鸟头）：面积比 = 两条夹边比的乘积"
        },
        {
          "t": "li",
          "v": "燕尾：$\\frac{S_{ABP}}{S_{BDP}}=\\frac{AP}{PD}$，须共顶点且底共线"
        },
        {
          "t": "li",
          "v": "给一块求整体：设总面积 $S$、最小块 $x$，用各块和 = 整体列方程"
        },
        {
          "t": "tip",
          "v": "识别：中点 $1:1$、三等分点 $1:2$，先找公共底或公共高"
        },
        {
          "t": "warn",
          "v": "易错：没共顶点、底没共线别套比例；面积比 $4:9$ 是边长 $2:3$"
        }
      ]
    },
    {
      "id": "oge-oblique-triangle",
      "title": "斜三角形面积",
      "span": 1,
      "pair_with": null,
      "blocks": [
        {
          "t": "fig",
          "v": "oblique-triangle"
        },
        {
          "t": "sec",
          "v": "等面积法"
        },
        {
          "t": "fx",
          "v": "ah_a=bh_b=ch_c=2S"
        },
        {
          "t": "li",
          "v": "已知面积和底反求高 $h=\\frac{2S}{a}$；同一三角形底与高成反比"
        },
        {
          "t": "sec",
          "v": "作高与补形"
        },
        {
          "t": "li",
          "v": "判钝角：最长边 $c$ 有 $a^2+b^2<c^2$ 时高落形外，底要延长"
        },
        {
          "t": "fx",
          "v": "h^2=AB^2-x^2=AC^2-(BC-x)^2"
        },
        {
          "t": "sec",
          "v": "两条特例"
        },
        {
          "t": "fx",
          "v": "S=\\frac{d_1d_2}{2},\\quad S_{\\text{等腰直角}}=\\frac{c^{2}}{4}"
        },
        {
          "t": "li",
          "v": "对角线须垂直（筝形、菱形）；等腰直角三角形中 $c$ 为斜边"
        },
        {
          "t": "tip",
          "v": "识别信号：只给三边、点在延长线上、方格纸上的三角形"
        },
        {
          "t": "warn",
          "v": "易错：底高要配对，$\\frac{1}{2}\\times$ 两条斜边只对直角三角形成立"
        }
      ]
    },
    {
      "id": "oge-area-comprehensive",
      "title": "面积综合",
      "span": 1,
      "pair_with": "oge-geometry-methods",
      "blocks": [
        {
          "t": "fig",
          "v": "area-synthesis"
        },
        {
          "t": "sec",
          "v": "四把刀"
        },
        {
          "t": "li",
          "v": "割补：边界弯折、缺角，用整体减空白或切下补上"
        },
        {
          "t": "li",
          "v": "旋转翻折：正方形、$45^\\circ$、相等邻边，把短线段接到一条直线"
        },
        {
          "t": "li",
          "v": "容斥：并集 = 两块之和减重叠；三块按加单、减双、加三"
        },
        {
          "t": "li",
          "v": "等积变换：有平行线就把顶点沿平行线滑到好算的位置"
        },
        {
          "t": "sec",
          "v": "关键变形"
        },
        {
          "t": "li",
          "v": "两块拼补：$S=S_1+S_2-S_3$，两块分居对角线两侧时更省事"
        },
        {
          "t": "li",
          "v": "$45^\\circ$ 旋转：正方形中转后拼出 $BE+DF$ 一条线段，两块等积"
        },
        {
          "t": "li",
          "v": "滑动出定值：平行关系不变则面积恒定，把顶点请到特殊位置"
        },
        {
          "t": "sec",
          "v": "判断与易错"
        },
        {
          "t": "li",
          "v": "看已知量选刀：长度多用割补，角多用旋转，求长度就设元列方程"
        },
        {
          "t": "li",
          "v": "旋转、割补、等积只保面积，周长和边长都可能变"
        },
        {
          "t": "tip",
          "v": "识别信号：阴影弯折或缺角、$45^\\circ$ 配正方形、两块叠放、平行线"
        },
        {
          "t": "warn",
          "v": "易错：斜边不能直接当高；容斥漏加三交；旋转要整体转"
        }
      ]
    },
    {
      "id": "oge-geometry-methods",
      "title": "几何思想方法",
      "span": 1,
      "pair_with": "oge-area-comprehensive",
      "blocks": [
        {
          "t": "fig",
          "v": "geometry-method"
        },
        {
          "t": "sec",
          "v": "五把钥匙"
        },
        {
          "t": "li",
          "v": "平移：沿直线整体移动，把散落的线段拼成一条"
        },
        {
          "t": "li",
          "v": "旋转：绕定点转过一个角，共顶点 + 等长 + 半角时最好用"
        },
        {
          "t": "li",
          "v": "割补：切开重拼，依据是整体 = 各部分之和"
        },
        {
          "t": "li",
          "v": "等积：顶点沿平行线滑动面积不变（拉车模型）"
        },
        {
          "t": "li",
          "v": "代数：设 $x$ 或 $x,y$，把面积、勾股、周长条件翻译成方程"
        },
        {
          "t": "sec",
          "v": "关键变形"
        },
        {
          "t": "li",
          "v": "半角旋转：正方形中 $\\angle EAF=45^\\circ$，则 $EF=BE+DF$"
        },
        {
          "t": "li",
          "v": "并排正方形：对角线平行，$S_{BDF}=\\frac{1}{2}a^2$ 与小正方形边长无关"
        },
        {
          "t": "fx",
          "v": "(a+b)^2+(a-b)^2=2c^2"
        },
        {
          "t": "li",
          "v": "弦图两次拼：已知 $a+b$ 与 $a-b$（或 $c$）可反求各边"
        },
        {
          "t": "li",
          "v": "设元解出后回图检查点是否还在线段上，增根要舍"
        },
        {
          "t": "tip",
          "v": "识别：$45^\\circ$、$60^\\circ$ 配等长线段想旋转；平行与中点想等积"
        },
        {
          "t": "warn",
          "v": "易错：只保面积不保周长；旋转要先证全等再用结论"
        }
      ]
    }
  ]
}