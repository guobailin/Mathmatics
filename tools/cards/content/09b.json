{
  "module_dir": "09-奥数-几何",
  "items": [
    {
      "id": "oge-pythagorean",
      "title": "勾股定理",
      "span": 1,
      "pair_with": "oge-lattice-area",
      "blocks": [
        {
          "t": "fig",
          "v": "pythagoras"
        },
        {
          "t": "sec",
          "v": "基本定理"
        },
        {
          "t": "fx",
          "v": "a^{2}+b^{2}=c^{2}"
        },
        {
          "t": "li",
          "v": "直角边 $a,b$，斜边 $c$ 取最长边；逆用可判直角"
        },
        {
          "t": "sec",
          "v": "勾股数"
        },
        {
          "t": "fx",
          "v": "(3,4,5)\\quad(5,12,13)\\quad(8,15,17)\\quad(7,24,25)"
        },
        {
          "t": "li",
          "v": "整组同乘 $k$ 仍是勾股数；有公因数先约掉再查"
        },
        {
          "t": "sec",
          "v": "三种用法"
        },
        {
          "t": "li",
          "v": "网格斜线长 $=\\sqrt{m^{2}+n^{2}}$，$m,n$ 为横纵差"
        },
        {
          "t": "li",
          "v": "作高双勾股：公共高相等，列平方差方程求解"
        },
        {
          "t": "li",
          "v": "展开最短：展平后连线，三种搭配逐一比较"
        },
        {
          "t": "li",
          "v": "判形状：比 $c^{2}$ 与 $a^{2}+b^{2}$，大钝小锐"
        },
        {
          "t": "li",
          "v": "毕达哥拉斯树：每长一层，新增加的面积 = 最初正方形面积"
        },
        {
          "t": "tip",
          "v": "信号：直角、垂直、高、对角线、网格斜线、整数边、最短"
        },
        {
          "t": "warn",
          "v": "易错：只用于直角三角形；先定最长边为 $c$，保留根号"
        }
      ]
    },
    {
      "id": "oge-circle-sector",
      "title": "圆与扇形",
      "span": 1,
      "pair_with": "oge-solid-geometry",
      "blocks": [
        {
          "t": "fig",
          "v": "circle-sector"
        },
        {
          "t": "sec",
          "v": "基本公式"
        },
        {
          "t": "fx",
          "v": "l=\\frac{n^\\circ\\pi r}{180^\\circ},\\quad S_{\\text{扇}}=\\frac{n^\\circ\\pi r^{2}}{360^\\circ}=\\frac{1}{2}lr"
        },
        {
          "t": "li",
          "v": "骨架：圆心角占周角的几分之几，弧与面积就占几分之几"
        },
        {
          "t": "li",
          "v": "已知弧长求面积用 $S=\\frac{1}{2}lr$，$l$ 只是弧长"
        },
        {
          "t": "sec",
          "v": "弓形扇环"
        },
        {
          "t": "li",
          "v": "弓形面积 $=$ 扇形减三角形；仅两侧弓形全等时，叶形 $=2$ 个弓形，否则分别求面积再相加"
        },
        {
          "t": "li",
          "v": "扇环面积差：$R^{2}-r^{2}=(R-r)(R+r)$，别只用环宽"
        },
        {
          "t": "sec",
          "v": "滚动扫过"
        },
        {
          "t": "li",
          "v": "外滚：圆心轨迹为直边加转角弧，转角共 $360^\\circ$"
        },
        {
          "t": "li",
          "v": "扫过条带宽 $2r$，转角处半径也是 $2r$"
        },
        {
          "t": "tip",
          "v": "信号：弧、扇形、圆心角、滚动、旋转、两半圆重叠"
        },
        {
          "t": "warn",
          "v": "易错：直径先除 $2$；弧长乘 $2\\pi r$，面积乘 $\\pi r^{2}$"
        }
      ]
    },
    {
      "id": "oge-perimeter",
      "title": "周长问题",
      "span": 1,
      "pair_with": "oge-perimeter-tricks",
      "blocks": [
        {
          "t": "fig",
          "v": "perimeter-problem"
        },
        {
          "t": "sec",
          "v": "基本公式"
        },
        {
          "t": "li",
          "v": "长方形 $C=2(a+b)$，正方形 $C=4a$"
        },
        {
          "t": "li",
          "v": "周长一定则长宽和一定，改围先求铁丝总长"
        },
        {
          "t": "sec",
          "v": "拼与切"
        },
        {
          "t": "fx",
          "v": "C_{\\text{拼}}=C_1+C_2-2d"
        },
        {
          "t": "li",
          "v": "剪开相反：每刀加 $2\\times$ 剪痕长；拼得越紧越短"
        },
        {
          "t": "li",
          "v": "接缝两侧等长才拼得齐，据此列长宽比（按份数设）"
        },
        {
          "t": "sec",
          "v": "分割与最值"
        },
        {
          "t": "li",
          "v": "内周长 $=$ 外周长 $-8d$，周长差 $\\div8$ 得框宽"
        },
        {
          "t": "li",
          "v": "各块周长和减拼后周长 $=2\\times$ 公共边总长"
        },
        {
          "t": "li",
          "v": "周长相等时越接近正方形，面积越大"
        },
        {
          "t": "tip",
          "v": "信号：同一根铁丝、拼剪挖、给几块周长、拼成大长方形"
        },
        {
          "t": "warn",
          "v": "易错：公共边要扣 $2d$；角上剪不变、边上挖加 $2h$"
        }
      ]
    },
    {
      "id": "oge-perimeter-tricks",
      "title": "巧求周长",
      "span": 1,
      "pair_with": "oge-perimeter",
      "blocks": [
        {
          "t": "fig",
          "v": "perimeter-tricks"
        },
        {
          "t": "sec",
          "v": "核心结论"
        },
        {
          "t": "fx",
          "v": "C=2(L+H)"
        },
        {
          "t": "li",
          "v": "横边凑 $L$、竖边凑 $H$，取最宽与最高跨度"
        },
        {
          "t": "li",
          "v": "条件：横、竖线去截都只截一段，边界不走回头路"
        },
        {
          "t": "sec",
          "v": "凹槽剪角"
        },
        {
          "t": "li",
          "v": "边中挖深 $h$ 的缺口：周长加 $2h$，与宽无关"
        },
        {
          "t": "li",
          "v": "角上剪去矩形：少的两段正好被新边补满，周长不变"
        },
        {
          "t": "sec",
          "v": "拼切改围"
        },
        {
          "t": "fx",
          "v": "C_{\\text{拼}}=C_1+C_2-2\\times(\\text{公共边})"
        },
        {
          "t": "li",
          "v": "由周长减少量 $\\div2$ 反求公共边；切开加 $2d$"
        },
        {
          "t": "li",
          "v": "同根铁丝：周长不变，$a+b=C\\div2$，越方越大"
        },
        {
          "t": "li",
          "v": "四小长方形围成带孔正方形：大边长 $=$ 长 $+$ 宽"
        },
        {
          "t": "tip",
          "v": "信号：台阶、十字、缺角、挖去、拼成、同一根铁丝"
        },
        {
          "t": "warn",
          "v": "易错：有凹就加 $2\\times$ 凹深；斜边不能平移进 $L,H$"
        }
      ]
    },
    {
      "id": "oge-lattice-area",
      "title": "格点面积",
      "span": 1,
      "pair_with": "oge-pythagorean",
      "blocks": [
        {
          "t": "fig",
          "v": "lattice-area"
        },
        {
          "t": "sec",
          "v": "皮克定理"
        },
        {
          "t": "fx",
          "v": "S=N+\\frac{B}{2}-1"
        },
        {
          "t": "li",
          "v": "$N$ 内部格点、$B$ 边界格点（含顶点），单位为小方格"
        },
        {
          "t": "sec",
          "v": "三角格点"
        },
        {
          "t": "fx",
          "v": "S=2N+L-2"
        },
        {
          "t": "li",
          "v": "单位三角形面积为 $1$；$N$、$L$ 含义同上，思想仍是割补"
        },
        {
          "t": "sec",
          "v": "点数与放缩"
        },
        {
          "t": "li",
          "v": "每边贡献 $=$ 横纵差的 $\\text{gcd}$，各边相加得 $B$"
        },
        {
          "t": "tip",
          "v": "信号：方格纸、格点、坐标、只给点数、半整数面积"
        },
        {
          "t": "warn",
          "v": "易错：面积必为 $0.5$ 的整数倍；有洞或顶点非格点失效"
        }
      ]
    },
    {
      "id": "oge-three-views",
      "title": "三视图求体积",
      "span": 1,
      "pair_with": "oge-surface-coloring",
      "blocks": [
        {
          "t": "fig",
          "v": "three-views"
        },
        {
          "t": "sec",
          "v": "视图含义"
        },
        {
          "t": "fx",
          "v": "V=Na^{3}"
        },
        {
          "t": "li",
          "v": "俯视图每格记层数 $h$，$N$ 为总块数、$a$ 为棱长"
        },
        {
          "t": "li",
          "v": "俯视图管底（哪格有方块）；主视图给各列最高层"
        },
        {
          "t": "li",
          "v": "左视图给各排最高层，其左右对应俯视图的前后"
        },
        {
          "t": "sec",
          "v": "每格上界"
        },
        {
          "t": "li",
          "v": "每格层数不超过所在列高、排高的较小者"
        },
        {
          "t": "li",
          "v": "求最多：每格顶到上界求和，空格记 $0$ 不参与"
        },
        {
          "t": "li",
          "v": "求最少：先铺底，再安排排、列代表格；仅排高=列高且交点有方块时可共用，多个选择冲突时要整体安排"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "打通洞：整条线记 $0$，重复减掉的交点要加回"
        },
        {
          "t": "li",
          "v": "视图不全或三视图相同：先定上下界再证可搭"
        },
        {
          "t": "tip",
          "v": "信号：最多/最少、至少、能否搭出、打洞贯穿、三视图相同"
        },
        {
          "t": "warn",
          "v": "易错：左视图最左对应俯视图最后一排；列高和 $\\ne$ 体积"
        }
      ]
    },
    {
      "id": "oge-surface-coloring",
      "title": "表面染色",
      "span": 1,
      "pair_with": "oge-three-views",
      "blocks": [
        {
          "t": "fig",
          "v": "surface-coloring"
        },
        {
          "t": "sec",
          "v": "四类公式"
        },
        {
          "t": "li",
          "v": "设内棱长 $m=n-2$，则三面 $=8$ 块（全在顶点）"
        },
        {
          "t": "li",
          "v": "两面 $=12m$（棱上除两端）"
        },
        {
          "t": "li",
          "v": "一面 $=6m^{2}$（面内除边框）、零面 $=m^{3}$（内核）"
        },
        {
          "t": "li",
          "v": "四类之和 $=n^{3}$；至少一面用补集 $n^{3}-(n-2)^{3}$"
        },
        {
          "t": "sec",
          "v": "长方体"
        },
        {
          "t": "fx",
          "v": "A=a-2,\\quad B=b-2,\\quad C=c-2"
        },
        {
          "t": "li",
          "v": "两面 $=4(A+B+C)$ 为一次式，可直接反解棱长"
        },
        {
          "t": "li",
          "v": "一面 $=2(AB+BC+CA)$、零面 $=ABC$ 为二次、三次式"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "缺面：先按六面算再逐块降级；两相对面不涂可降维成一排"
        },
        {
          "t": "li",
          "v": "粘合：贴缝处红色仍在，须回该层重新分类"
        },
        {
          "t": "tip",
          "v": "信号：表面涂色后切成小正方体、至少一面、没涂色"
        },
        {
          "t": "warn",
          "v": "易错：棱上只数 $n-2$ 块，两端属顶点；长方体别套正方体"
        }
      ]
    },
    {
      "id": "oge-solid-geometry",
      "title": "立体几何综合",
      "span": 1,
      "pair_with": "oge-circle-sector",
      "blocks": [
        {
          "t": "fig",
          "v": "solid-geometry"
        },
        {
          "t": "sec",
          "v": "柱锥公式"
        },
        {
          "t": "fx",
          "v": "V_{\\text{柱}}=S_{\\text{底}}h,\\quad V_{\\text{锥}}=\\frac{1}{3}S_{\\text{底}}h"
        },
        {
          "t": "fx",
          "v": "S_{\\text{柱侧}}=2\\pi rh,\\quad S_{\\text{锥侧}}=\\pi rl"
        },
        {
          "t": "li",
          "v": "圆柱 $V=\\pi r^{2}h$、圆锥母线 $l=\\sqrt{r^{2}+h^{2}}$"
        },
        {
          "t": "li",
          "v": "长方体 $V=abc$、$S=2(ab+bc+ca)$"
        },
        {
          "t": "sec",
          "v": "展开图"
        },
        {
          "t": "li",
          "v": "圆柱侧展为长方形：长 $=2\\pi r$、宽 $=h$"
        },
        {
          "t": "sec",
          "v": "守恒与变形"
        },
        {
          "t": "li",
          "v": "熔铸倒水体积不变；切一刀表面积加 $2S_{\\text{切}}$"
        },
        {
          "t": "li",
          "v": "排水法：上升高度 $=\\frac{V_{\\text{浸}}}{S_{\\text{容底}}}$，先判完全浸没"
        },
        {
          "t": "tip",
          "v": "信号：水面上升、熔铸倒入、切后表面积增加、绕柱最短"
        },
        {
          "t": "warn",
          "v": "易错：先判是否浸没；洞口别重复加；表面积体积单位分清"
        }
      ]
    },
    {
      "id": "oge-angle-calculation",
      "title": "角度计算",
      "span": 1,
      "pair_with": null,
      "blocks": [
        {
          "t": "sec",
          "v": "内角和与外角和"
        },
        {
          "t": "fx",
          "v": "(n-2)\\times180^\\circ"
        },
        {
          "t": "li",
          "v": "外角和恒为 $360^\\circ$，与边数无关；给外角求边数直接 $360^\\circ\\div$ 外角"
        },
        {
          "t": "sec",
          "v": "外角定理"
        },
        {
          "t": "fx",
          "v": "\\angle ACD=\\angle A+\\angle B"
        },
        {
          "t": "li",
          "v": "五角星、凹四边形、折线求尖角和——把分散的角逐个搬进同一个三角形"
        },
        {
          "t": "sec",
          "v": "平行线拐点"
        },
        {
          "t": "li",
          "v": "唯一动作：过拐点作第三条平行线，用内错角把一个大角拆成两个"
        },
        {
          "t": "li",
          "v": "拐点在两线之间相加，移到延长线外侧相减"
        },
        {
          "t": "sec",
          "v": "折叠"
        },
        {
          "t": "fx",
          "v": "\\angle1+\\angle2=2\\angle A"
        },
        {
          "t": "li",
          "v": "折痕两侧全等 $\\angle ADE=\\angle A'DE$，再借 $D$、$E$ 处的平角列式"
        },
        {
          "t": "tip",
          "v": "识别：问边数→内角和；问尖角之和→外角定理；见折痕→等角加平角"
        },
        {
          "t": "warn",
          "v": "易错：外角要由一边延长得到；拐点内侧相加、外侧相减别套反"
        }
      ]
    }
  ]
}
