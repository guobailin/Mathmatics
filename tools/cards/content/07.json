{
  "module_dir": "07-奥数-计数",
  "items": [
    {
      "id": "cnt-geometry-count",
      "title": "几何计数",
      "span": 1,
      "pair_with": "cnt-circle-regions",
      "blocks": [
        {
          "t": "sec",
          "v": "基本公式"
        },
        {
          "t": "li",
          "v": "直线上 $n$ 个点：线段、角的个数都是 $C_n^2=\\frac{n(n-1)}{2}$"
        },
        {
          "t": "li",
          "v": "三角形：三线定一个，先算 $C_m^3$ 再剔三线共点"
        },
        {
          "t": "li",
          "v": "网格 $a$ 行 $b$ 列，长方形的个数为"
        },
        {
          "t": "fx",
          "v": "C_{a+1}^2\\times C_{b+1}^2"
        },
        {
          "t": "li",
          "v": "正方形（每小格相等，长 $n$ 份、宽 $m$ 份）个数为"
        },
        {
          "t": "fx",
          "v": "nm+(n-1)(m-1)+\\cdots+(m-n+1)\\times1"
        },
        {
          "t": "li",
          "v": "所有长方形面积和 = 长边各线段长之和 $\\times$ 宽边各线段长之和"
        },
        {
          "t": "li",
          "v": "斜正方形：外接方框边长为 $s$，框内恰有 $s-1$ 个"
        },
        {
          "t": "sec",
          "v": "常用套路"
        },
        {
          "t": "li",
          "v": "含指定格（☆）：上、下、左、右线段数连乘（边界夹住）"
        },
        {
          "t": "li",
          "v": "含甲或含乙：用容斥，同时含则四边取更严的边界"
        },
        {
          "t": "tip",
          "v": "识别信号：问\"共有多少个\"，先找唯一确定它的元素组"
        },
        {
          "t": "warn",
          "v": "易错：只数小图形；三线共点没剔；正方形也算长方形"
        }
      ]
    },
    {
      "id": "cnt-ie-extremum",
      "title": "容斥最值",
      "span": 1,
      "pair_with": "cnt-inclusion-exclusion",
      "blocks": [
        {
          "t": "sec",
          "v": "主公式"
        },
        {
          "t": "li",
          "v": "记 $S_1=|A|+|B|+|C|$，$m$ 为并集人数"
        },
        {
          "t": "li",
          "v": "参加 $k$ 项者被数 $k$ 次，总票数满足"
        },
        {
          "t": "fx",
          "v": "S_1=n_1+2n_2+3n_3"
        },
        {
          "t": "fx",
          "v": "n_2=S_1-m-2n_3,\\quad n_1=2m-S_1+n_3"
        },
        {
          "t": "li",
          "v": "两集合：$|A\\cap B|=|A|+|B|-m$"
        },
        {
          "t": "sec",
          "v": "定范围"
        },
        {
          "t": "li",
          "v": "每人至少一项则 $m=n$；允许不参加则 $m\\le n$"
        },
        {
          "t": "li",
          "v": "上界由 $n_2\\ge0$ 定：$n_3\\le\\frac{S_1-n}{2}$"
        },
        {
          "t": "li",
          "v": "并集不满时 $n_3\\ge S_1-2n$，负数取 $0$"
        },
        {
          "t": "li",
          "v": "给了一个两两交集，就有「只参加一项」的量被锁死"
        },
        {
          "t": "tip",
          "v": "识别信号：至少、至多、都参加、只参加，配几组人数"
        },
        {
          "t": "warn",
          "v": "易错：只列不等式不构造；逐项人数要查非负"
        }
      ]
    },
    {
      "id": "cnt-permutation-combination",
      "title": "排列组合",
      "span": 1,
      "pair_with": "cnt-add-multiply",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "li",
          "v": "排列 $A_n^m$：排成一列，交换算新；组合 $C_n^m$：只看是谁"
        },
        {
          "t": "fx",
          "v": "A_n^m=n(n-1)\\cdots(n-m+1),\\quad C_n^m=\\frac{A_n^m}{m!}"
        },
        {
          "t": "li",
          "v": "组合是\"先排序、再除 $m!$\"，一切除序都源于这一步"
        },
        {
          "t": "fx",
          "v": "C_n^0=C_n^n=1,\\quad C_n^m=C_n^{n-m},\\quad C_n^0+C_n^1+\\cdots+C_n^n=2^n"
        },
        {
          "t": "sec",
          "v": "固定动作"
        },
        {
          "t": "li",
          "v": "捆绑：相邻元素压成整体排队，最后乘回内部排法"
        },
        {
          "t": "li",
          "v": "插空：先排无约束的 $n$ 个，留 $n+1$ 个空，每空至多一个"
        },
        {
          "t": "li",
          "v": "除序：无标号且人数相同的组，除以同大小组数的阶乘"
        },
        {
          "t": "li",
          "v": "隔板法：相同物品每人至少 $1$ 个，方案数为 $C_{n-1}^{m-1}$"
        },
        {
          "t": "li",
          "v": "环形：只把旋转视为相同，镜像仍不同，$n$ 人围成一圈是 $(n-1)!$"
        },
        {
          "t": "tip",
          "v": "识别信号：排队职务→排列；挑出握手→组合；相邻→捆绑；不相邻→插空；至少→排除"
        },
        {
          "t": "warn",
          "v": "易错：均匀分组忘除 $3!$；分完组忘了乘分配数"
        }
      ]
    },
    {
      "id": "cnt-probability",
      "title": "概率初步",
      "span": 1,
      "pair_with": "cnt-pigeonhole",
      "blocks": [
        {
          "t": "sec",
          "v": "古典概型"
        },
        {
          "t": "li",
          "v": "结果有限且机会相同时，概率 $=$ 有利结果数除以全部结果数"
        },
        {
          "t": "fx",
          "v": "P(A)=\\frac{m}{n},\\quad P(\\overline{A})=1-P(A)"
        },
        {
          "t": "li",
          "v": "对立事件：见\"至少、不全、不都是\"，先算反面"
        },
        {
          "t": "li",
          "v": "分步相乘、分类相加；只有互斥的路径才能相加"
        },
        {
          "t": "sec",
          "v": "关键检查"
        },
        {
          "t": "li",
          "v": "有序与无序可互换，但分子分母必须用同一标准"
        },
        {
          "t": "li",
          "v": "放回则每次概率不变；不放回要重算剩下的个数"
        },
        {
          "t": "li",
          "v": "树状图管\"先胜 $k$ 局\"，别漏提前结束的那些路径"
        },
        {
          "t": "li",
          "v": "已知概率反求个数：整理成整数方程再因数配对"
        },
        {
          "t": "li",
          "v": "概率只说机会大小，不等于\"做 $n$ 次必出现一次\""
        },
        {
          "t": "tip",
          "v": "识别信号：任意、随机、公平、至少、先胜 $k$ 局"
        },
        {
          "t": "warn",
          "v": "易错：骰子点数和 $2\\sim12$ 不等可能，分母是 $36$"
        }
      ]
    },
    {
      "id": "cnt-classification",
      "title": "分类列举",
      "span": 1,
      "pair_with": "cnt-enumeration",
      "blocks": [
        {
          "t": "sec",
          "v": "三条要求"
        },
        {
          "t": "li",
          "v": "标准统一、互不相交、合起来是全部（前者不重、后者不漏）"
        },
        {
          "t": "li",
          "v": "选标准：类数少、类内立刻可数、每一类都写得出来"
        },
        {
          "t": "li",
          "v": "补集：符合 $=$ 全部 $-$ 不符合，它是\"只分两类\"的特例"
        },
        {
          "t": "li",
          "v": "条件只管住一位（个位定奇偶）就先锁住那一位"
        },
        {
          "t": "sec",
          "v": "高级变形"
        },
        {
          "t": "li",
          "v": "有序化去重：先强制 $a<b<c$，再把边界写成不等式"
        },
        {
          "t": "li",
          "v": "对称配对：能一一配对且每对一个合格，就恰占一半"
        },
        {
          "t": "li",
          "v": "分层分类：先切大层再切小层，仍然不重不漏"
        },
        {
          "t": "li",
          "v": "类内能乘的前提：不管第一步选啥，第二步都同样多"
        },
        {
          "t": "li",
          "v": "含零时四位数有 $4!-3!$ 个（零在首位要扣掉）"
        },
        {
          "t": "tip",
          "v": "识别信号：条件零碎、公式套不上，还带\"至少\"\"不计顺序\""
        },
        {
          "t": "warn",
          "v": "易错：中途换分类标准；用补集时漏掉边界那个数"
        }
      ]
    },
    {
      "id": "cnt-pigeonhole",
      "title": "抽屉原理",
      "span": 1,
      "pair_with": "cnt-probability",
      "blocks": [
        {
          "t": "sec",
          "v": "基本形式"
        },
        {
          "t": "li",
          "v": "一般形式：必有一只抽屉的个数不小于 $\\frac mn$ 向上取整"
        },
        {
          "t": "li",
          "v": "带余除法：能整除取商，不能整除时商加 $1$"
        },
        {
          "t": "li",
          "v": "保证型：要有 $k$ 个同抽屉，物体至少 $n(k-1)+1$ 个"
        },
        {
          "t": "li",
          "v": "平均型：总和分成 $n$ 组，必有一组和不小于平均值"
        },
        {
          "t": "li",
          "v": "抽屉要事先分好且不重不漏；结论只保证存在"
        },
        {
          "t": "sec",
          "v": "造抽屉"
        },
        {
          "t": "li",
          "v": "常用分法：按余数、按奇数部分分链 $n=2^aq$、按相邻配对"
        },
        {
          "t": "li",
          "v": "链式抽屉：同一条链（同 $q$）任意两数成倍数，跨链不一定"
        },
        {
          "t": "li",
          "v": "反证：每只至多 $k-1$ 个则总数不超过 $n(k-1)$，装不下"
        },
        {
          "t": "li",
          "v": "还要构造出最坏分法，才能说明这个数不能再少"
        },
        {
          "t": "tip",
          "v": "识别信号：保证、必有、至少取多少——先造最坏情形再加 $1$"
        },
        {
          "t": "warn",
          "v": "易错：整除时不能再加 $1$；只证存在不证最紧"
        }
      ]
    },
    {
      "id": "cnt-insertion",
      "title": "插空法",
      "span": 1,
      "pair_with": "cnt-bundling",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "li",
          "v": "先排无限制的一方当隔板，$m$ 个隔板共留出 $m+1$ 个空"
        },
        {
          "t": "li",
          "v": "每空至多放一个，插入元素必不相邻；反过来也一一对应"
        },
        {
          "t": "li",
          "v": "总数 $=$ 隔板排法 $\\times$ 选空并安排的方式数"
        },
        {
          "t": "li",
          "v": "插入元素互异用 $A_{m+1}^k$，完全相同改用 $C_{m+1}^k$"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "端点受限：首尾两空作废，可用空从 $m+1$ 减到 $m-1$"
        },
        {
          "t": "li",
          "v": "一排 $n$ 个座位选 $k$ 个互不相邻，方案数为"
        },
        {
          "t": "fx",
          "v": "C_{n-k+1}^{k}"
        },
        {
          "t": "li",
          "v": "环形：围成一圈只有 $m$ 个空，圆排列为 $(m-1)!$"
        },
        {
          "t": "li",
          "v": "先捆绑再插空：隔板是\"整体\"不是人，单位数要重算"
        },
        {
          "t": "tip",
          "v": "识别信号：互不相邻、隔开、不能挨着——先数谁多谁少"
        },
        {
          "t": "warn",
          "v": "易错：漏数两端两个空；一个空塞两人就必相邻"
        }
      ]
    },
    {
      "id": "cnt-circle-regions",
      "title": "线分圆环",
      "span": 1,
      "pair_with": "cnt-geometry-count",
      "blocks": [
        {
          "t": "sec",
          "v": "一般位置"
        },
        {
          "t": "li",
          "v": "新直线被切成 $n$ 段，就新增 $n$ 块"
        },
        {
          "t": "fx",
          "v": "R(n)=1+\\frac{n(n+1)}2=1+n+\\binom n2"
        },
        {
          "t": "li",
          "v": "起点 $R(0)=1$；圆最多分 $2+n(n-1)$ 块；只数圆内交点"
        },
        {
          "t": "sec",
          "v": "特殊位置"
        },
        {
          "t": "li",
          "v": "块数 $=1+n+$ 各交点的贡献之和"
        },
        {
          "t": "li",
          "v": "$k$ 条共点比一般位置少"
        },
        {
          "t": "fx",
          "v": "\\frac{(k-1)(k-2)}2"
        },
        {
          "t": "li",
          "v": "圆周 $m$ 点两两连弦，块数为"
        },
        {
          "t": "fx",
          "v": "1+\\binom m2+\\binom m4"
        },
        {
          "t": "tip",
          "v": "识别信号：最多分成几块、任意两条相交、无三线共点"
        },
        {
          "t": "warn",
          "v": "易错：忘加起始的 $1$；$k$ 重点只贡献 $k-1$"
        }
      ]
    },
    {
      "id": "cnt-add-multiply",
      "title": "加乘原理",
      "span": 1,
      "pair_with": "cnt-permutation-combination",
      "blocks": [
        {
          "t": "sec",
          "v": "两原理"
        },
        {
          "t": "li",
          "v": "加法（分类）：各类互斥且穷尽，$N=m_1+m_2+\\cdots+m_k$"
        },
        {
          "t": "li",
          "v": "乘法（分步）：每一步的可选数对所有前序方案相同，$N=n_1n_2\\cdots n_k$"
        },
        {
          "t": "li",
          "v": "判据：选一条路就结束用加；每步都缺一不可才用乘"
        },
        {
          "t": "li",
          "v": "嵌套：每一类内部连乘，再把各类的结果相加"
        },
        {
          "t": "li",
          "v": "取的个数接近总数时，改成数\"去掉哪几个\"更省事"
        },
        {
          "t": "sec",
          "v": "三个变形"
        },
        {
          "t": "li",
          "v": "先分类再分步：把破坏独立性的那个量定为分类标准"
        },
        {
          "t": "li",
          "v": "补集（正难则反）：全部减不符合，违规重叠时还要容斥"
        },
        {
          "t": "li",
          "v": "对称配对：两两配对且每对一个合格则占一半，先验一一对应"
        },
        {
          "t": "li",
          "v": "特殊位置优先：先安排最受限制的位置或元素"
        },
        {
          "t": "tip",
          "v": "识别信号：首位不能为 $0$、某人不在两端、至少一个"
        },
        {
          "t": "warn",
          "v": "易错：不独立硬乘——某步选择数随前步变时必须先分类"
        }
      ]
    },
    {
      "id": "cnt-consecutive-sum",
      "title": "拆连续自然数",
      "span": 1,
      "pair_with": "cnt-symmetry-count",
      "blocks": [
        {
          "t": "sec",
          "v": "核心方程"
        },
        {
          "t": "fx",
          "v": "2N=k(2a+k-1),\\quad a=\\frac{2N/k-k+1}{2}"
        },
        {
          "t": "li",
          "v": "两因数一奇一偶，奇的那个一定是 $N$ 的奇因数"
        },
        {
          "t": "li",
          "v": "拆法种数（含 $N$ 本身）就是 $N$ 的奇因数个数"
        },
        {
          "t": "li",
          "v": "问\"至少两项\"要减掉 $d=1$ 对应的单项那一种"
        },
        {
          "t": "sec",
          "v": "怎么用"
        },
        {
          "t": "li",
          "v": "已知 $N$：只数奇素因子，个数为各指数加 $1$ 后连乘"
        },
        {
          "t": "li",
          "v": "已知项数用中项定位：奇项中项 $=\\frac Nk$，偶项是半整数"
        },
        {
          "t": "li",
          "v": "偶项数所含 $2$ 的方幂，等于 $2N$ 中的方幂"
        },
        {
          "t": "li",
          "v": "项数上界 $k(k+1)\\le2N$；超上界的奇因数让位给偶项"
        },
        {
          "t": "li",
          "v": "首项必须验 $a\\ge1$；拆连续倍数先提出公因数 $m$"
        },
        {
          "t": "tip",
          "v": "识别信号：连续自然数之和——先写 $2N=k(2a+k-1)$"
        },
        {
          "t": "warn",
          "v": "易错：用因数个数冒充奇因数个数；忘了验 $a\\ge1$"
        }
      ]
    },
    {
      "id": "cnt-enumeration",
      "title": "枚举与分类",
      "span": 1,
      "pair_with": "cnt-classification",
      "blocks": [
        {
          "t": "sec",
          "v": "两件工具"
        },
        {
          "t": "li",
          "v": "分类：块块无公共、合起来是全部，各类个数相加"
        },
        {
          "t": "li",
          "v": "定序：类内定死书写顺序（从小到大、强制 $a<b$），可查跳号"
        },
        {
          "t": "li",
          "v": "分步相乘：不管第一步选啥，第二步都同样多才敢乘"
        },
        {
          "t": "li",
          "v": "补集：所求 $=$ 总数 $-$ 不合要求数；环形先\"破环为链\""
        },
        {
          "t": "sec",
          "v": "高级变形"
        },
        {
          "t": "li",
          "v": "逐位比较：按第一个不同的位置分类，从最高位往下比"
        },
        {
          "t": "li",
          "v": "对称配对：两角色对称可只数一半再乘 $2$，或用总数减"
        },
        {
          "t": "li",
          "v": "状态递推：非目标状态恰有一种转入目标状态时，$a_{n+1}=T_n-a_n$"
        },
        {
          "t": "li",
          "v": "分类标准常常就是题目条件本身：余数、数字和、首位"
        },
        {
          "t": "li",
          "v": "数完必须换路验算：换标准、总数减补集、对称性配对"
        },
        {
          "t": "tip",
          "v": "识别信号：总数几百以内、条件零碎、问\"有多少种\""
        },
        {
          "t": "warn",
          "v": "易错：想到哪写到哪；一题中途换第二个分类标准"
        }
      ]
    },
    {
      "id": "cnt-symmetry-count",
      "title": "轴对称情况计数",
      "span": 1,
      "pair_with": "cnt-consecutive-sum",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "li",
          "v": "轴外位置两两配对，一对必须同色；轴上点与自己配对"
        },
        {
          "t": "li",
          "v": "轴外 $m$ 对必须同色，轴上 $t$ 个不动点可单独决定"
        },
        {
          "t": "li",
          "v": "每格有 $k$ 种颜色可选时，对称染色总数为"
        },
        {
          "t": "fx",
          "v": "N=k^{m+t}"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "数量限制按贡献记账：轴外一对记 $2$ 格，轴上一点记 $1$"
        },
        {
          "t": "li",
          "v": "某色恰 $n$ 格：解 $a+2p=n$ 且各量非负"
        },
        {
          "t": "li",
          "v": "两条轴：按能互相重合的轨道分组，组大小可为 $1,2,4$"
        },
        {
          "t": "li",
          "v": "排列题：首尾对称的两位配对，中间位由人数奇偶定死"
        },
        {
          "t": "li",
          "v": "问\"至少一条轴\"是并集：按轴的条数分类再扣重复"
        },
        {
          "t": "tip",
          "v": "识别信号：对折重合、左右一样、回文、至少一条对称轴"
        },
        {
          "t": "warn",
          "v": "易错：漏掉轴上不动点；一对同色要记 $2$ 格不是 $1$ 格"
        }
      ]
    },
    {
      "id": "cnt-inclusion-exclusion",
      "title": "容斥原理",
      "span": 1,
      "pair_with": "cnt-ie-extremum",
      "blocks": [
        {
          "t": "sec",
          "v": "公式"
        },
        {
          "t": "fx",
          "v": "|A\\cup B|=|A|+|B|-|A\\cap B|"
        },
        {
          "t": "li",
          "v": "三量：单集合之和，减两两交集之和，再加三项交集"
        },
        {
          "t": "fx",
          "v": "|A\\cup B\\cup C|=|A|+|B|+|C|-|A\\cap B|-|B\\cap C|-|C\\cap A|+|A\\cap B\\cap C|"
        },
        {
          "t": "sec",
          "v": "分层"
        },
        {
          "t": "li",
          "v": "按\"满足几项\"分四层：$S=a+2b+3t$，$P=b+3t$"
        },
        {
          "t": "li",
          "v": "反解各层：只一项 $a=S-2P+3t$，恰两项 $b=P-3t$"
        },
        {
          "t": "li",
          "v": "总数校验：$a+b+t+n=N$，$n$ 为三项都不满足的人数"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "补集：都不人数 $=|U|-$ 并集；至少一项 $=N-$ 都不"
        },
        {
          "t": "li",
          "v": "周期化：以最小公倍数分块，整块乘倍数，零头单独数"
        },
        {
          "t": "li",
          "v": "先并后筛：减去的是并集与 $C$ 的交集，不是整个 $C$"
        },
        {
          "t": "tip",
          "v": "识别信号：或、至少一个、既…又…、都不、第几个"
        },
        {
          "t": "warn",
          "v": "易错：三量忘加回三项交集；公倍数要用最小公倍数"
        }
      ]
    },
    {
      "id": "cnt-bundling",
      "title": "捆绑法与除序法",
      "span": 1,
      "pair_with": "cnt-insertion",
      "blocks": [
        {
          "t": "sec",
          "v": "捆绑"
        },
        {
          "t": "li",
          "v": "相邻的 $k$ 人捆成整体，排完整体再乘内部 $k!$"
        },
        {
          "t": "li",
          "v": "多组捆绑：整体数 = 总人数 − 各组人数之和 + 组数"
        },
        {
          "t": "li",
          "v": "整体数不是 $n-r$：每组捆完只占一个位置"
        },
        {
          "t": "sec",
          "v": "除序"
        },
        {
          "t": "li",
          "v": "$m$ 个不同元素相对顺序固定时，除以 $m!$；相同元素按重复类阶乘除"
        },
        {
          "t": "li",
          "v": "无标号分组只除以组名交换对称数；同人数组有 $r$ 组才除 $r!$，不同人数不除"
        },
        {
          "t": "li",
          "v": "平均分组：先按有标号算，最后除以同人数各组的组名置换数"
        },
        {
          "t": "li",
          "v": "顺序：先捆绑，再对整体除序，最后乘内部倍数"
        },
        {
          "t": "sec",
          "v": "判断"
        },
        {
          "t": "li",
          "v": "相邻要乘、定序才除；看到\"必须挨着\"别去除"
        },
        {
          "t": "li",
          "v": "恰有 $k$ 人相邻要排除 $k+1$ 人连成一块的情形"
        },
        {
          "t": "tip",
          "v": "识别信号：相邻连坐→捆绑；甲在乙前、平均分组→除序"
        },
        {
          "t": "warn",
          "v": "易错：捆绑忘乘内部排法；除序除成 $3$ 而不是 $3!$"
        }
      ]
    },
    {
      "id": "cnt-path-count",
      "title": "标数法",
      "span": 1,
      "pair_with": "cnt-recursion",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "li",
          "v": "每步只让坐标增加；起点标 $1$，其余各点填\"前驱之和\""
        },
        {
          "t": "fx",
          "v": "f(i,j)=f(i-1,j)+f(i,j-1)"
        },
        {
          "t": "li",
          "v": "矩形网格：向右 $m$ 格、向上 $n$ 格，最短路条数为"
        },
        {
          "t": "fx",
          "v": "\\binom{m+n}{n}"
        },
        {
          "t": "sec",
          "v": "变形"
        },
        {
          "t": "li",
          "v": "允许斜走时多加一个前驱，再补上左下那个数"
        },
        {
          "t": "li",
          "v": "障碍点标 $0$；整片禁区的点全标 $0$，边界上的照常"
        },
        {
          "t": "li",
          "v": "必经 $P$：分段相乘，两段各自重新数横竖格数"
        },
        {
          "t": "li",
          "v": "两个障碍先比坐标定先后，可比才加回重叠的部分"
        },
        {
          "t": "li",
          "v": "至少经过一站是并集：两站相加再减去交集"
        },
        {
          "t": "tip",
          "v": "识别信号：只能向右或向上、最短路线、不越过、必经"
        },
        {
          "t": "warn",
          "v": "易错：把格数当步数；障碍点空着不标 $0$"
        }
      ]
    },
    {
      "id": "cnt-recursion",
      "title": "递推与归纳",
      "span": 1,
      "pair_with": "cnt-path-count",
      "blocks": [
        {
          "t": "sec",
          "v": "模型"
        },
        {
          "t": "li",
          "v": "递推式 $+$ 初始值才定死一列数，二阶给两个初值"
        },
        {
          "t": "li",
          "v": "一阶：$a_n=a_{n-1}+f(n)$，每步新增的量有规律"
        },
        {
          "t": "li",
          "v": "二阶：$a_n=a_{n-1}+a_{n-2}$；状态多设两个数列"
        },
        {
          "t": "li",
          "v": "周期：状态有限走够多步必重复，找状态对第一次重复"
        },
        {
          "t": "sec",
          "v": "工具"
        },
        {
          "t": "li",
          "v": "累加求通项：新增量成等差则是二次式，再差一次是三次式"
        },
        {
          "t": "li",
          "v": "差分表当探照灯：先枚举 $3\\sim5$ 项，看几阶差为常数"
        },
        {
          "t": "li",
          "v": "定位取余：余数为 $0$ 时取周期末项，不能取\"第 $0$ 项\""
        },
        {
          "t": "li",
          "v": "归纳计数：第 $k$ 个图形最多新增 $c(k-1)$ 块"
        },
        {
          "t": "fx",
          "v": "2+2n(n-1),\\;2+3n(n-1),\\;2+4n(n-1)"
        },
        {
          "t": "li",
          "v": "依次为椭圆、三角形、长方形（交点系数 $c=4,6,8$）"
        },
        {
          "t": "tip",
          "v": "识别信号：第 $n$ 次、$n$ 条、最多分成几块、回到原处"
        },
        {
          "t": "warn",
          "v": "易错：只写递推不写初始值；把交点数当新增块数"
        }
      ]
    }
  ]
}
