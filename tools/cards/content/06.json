          "t": "fx",
          "v": "12345679\\times9=111111111,\\quad 12345679\\times8=98765432"
        },
        {
          "t": "fx",
          "v": "142857\\times2=285714,\\quad \\times3=428571,\\quad \\cdots,\\quad \\times7=999999"
        },
        {
          "t": "fx",
          "v": "111\\cdots1\\times111\\cdots1=123\\cdots n\\cdots321,\\quad 1+2+\\cdots+n+\\cdots+2+1=n^2"
        },
        {
          "t": "fx",
          "v": "1234+2341+3412+4123=1111\\times(1+2+3+4)"
        },
