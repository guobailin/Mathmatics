{
  "module_dir": "02-代数初步",
  "items": [
    {
      "id": "eq-types",
      "title": "各类方程的解法",
      "badge": "代数 · 方程",
      "blocks": [
        {
          "t": "sec",
          "v": "整式方程：先去括号·去分母，再移项"
        },
        {
          "t": "li",
          "v": "一般　$3x+5=20\\ \\Rightarrow\\ x=5$（移项、除以 $3$）"
        },
        {
          "t": "li",
          "v": "括号　$2(x-3)=10\\ \\Rightarrow\\ x=8$（先去括号）"
        },
        {
          "t": "li",
          "v": "分数　$\\frac{x}{3}+5=11\\ \\Rightarrow\\ x=18$（先减 $5$，再乘 $3$）"
        },
        {
          "t": "li",
          "v": "小数　$0.2x+1.5=0.3x\\ \\Rightarrow\\ x=15$（两边乘 $10$）"
        },
        {
          "t": "sec",
          "v": "比例方程：内项积 = 外项积"
        },
        {
          "t": "li",
          "v": "$x:4=3:6\\ \\Rightarrow\\ 6x=12\\ \\Rightarrow\\ x=2$"
        },
        {
          "t": "sec",
          "v": "分式方程：去分母后必须验根"
        },
        {
          "t": "li",
          "v": "$\\frac{1}{x-1}=2\\ \\Rightarrow\\ x=\\frac{3}{2}$（需 $x\\ne 1$）"
        },
        {
          "t": "sec",
          "v": "二元一次方程组：消元"
        },
        {
          "t": "li",
          "v": "$x+y=8,\\ x-y=2\\ \\Rightarrow\\ (5,3)$（两式相加消 $y$）"
        },
        {
          "t": "tip",
          "v": "第一步看形状：有分母就去分母、有小数点就乘 $10$、有比例号就交叉相乘"
        },
        {
          "t": "warn",
          "v": "易错：移项必须变号；分式方程去分母后要验根，使分母为 $0$ 的解必须舍去"
        }
      ]
    }
  ]
}
