.header { padding: 24rpx; background: #3b6ef6; }
.search-box {
  background: #fff; border-radius: 32rpx; padding: 16rpx 28rpx;
  color: #999; font-size: 26rpx;
}
.section-title { margin: 28rpx 24rpx 8rpx; font-weight: bold; font-size: 30rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.grid-item {
  width: calc(50% - 24rpx); margin: 12rpx; background: #fff;
  border-radius: 12rpx; padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
}
.grid-name { font-size: 30rpx; font-weight: bold; }
.grid-count { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.fav-entry { text-align: center; color: #f60; font-weight: bold; }
